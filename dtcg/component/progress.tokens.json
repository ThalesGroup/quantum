{
  "progress": {
    "bar": {
      "caption": {
        "color": {
          "$value": "{color.bluegrey.500}"
        },
        "error": {
          "color": {
            "$value": "{color.red.500}"
          }
        }
      },
      "font": {
        "family": {
          "$value": "{font.family.roboto}"
        },
        "weight": {
          "$value": "{font.weight.regular}"
        }
      },
      "height": {
        "$value": "{border.size.thick}"
      },
      "label": {
        "color": {
          "$value": "{color.bluegrey.900}"
        },
        "font": {
          "weight": {
            "$value": "{font.weight.medium}"
          }
        },
        "large": {
          "font": {
            "size": {
              "$value": "{font.scale.6.size}"
            }
          },
          "line": {
            "height": {
              "$value": "{font.scale.6.line.height}"
            }
          }
        },
        "medium": {
          "font": {
            "size": {
              "$value": "{font.scale.7.size}"
            }
          },
          "line": {
            "height": {
              "$value": "{font.scale.7.line.height}"
            }
          }
        },
        "small": {
          "font": {
            "size": {
              "$value": "{font.scale.8.size}"
            }
          },
          "line": {
            "height": {
              "$value": "{font.scale.8.line.height}"
            }
          }
        }
      },
      "lead": {
        "border": {
          "radius": {
            "$value": "{border.radius.medium}"
          }
        },
        "error": {
          "color": {
            "$value": "{color.red.500}"
          }
        },
        "success": {
          "color": {
            "$value": "{color.green.500}"
          }
        }
      },
      "margin": {
        "top": {
          "$value": "{spacing.xs}"
        }
      },
      "neutral": {
        "lead": {
          "color": {
            "$value": "{color.bluegrey.500}"
          }
        }
      },
      "percentage": {
        "color": {
          "$value": "{color.bluegrey.900}"
        },
        "font": {
          "size": {
            "$value": "{font.scale.8.size}"
          },
          "weight": {
            "$value": "{font.weight.bold}"
          }
        },
        "large": {
          "font": {
            "size": {
              "$value": "{font.scale.7.size}"
            }
          },
          "line": {
            "height": {
              "$value": "{font.scale.7.line.height}"
            }
          }
        },
        "line": {
          "height": {
            "$value": "{font.scale.8.line.height}"
          }
        }
      },
      "primary": {
        "lead": {
          "color": {
            "$value": "{color.primary.500}"
          }
        }
      },
      "track": {
        "animation": {
          "duration": {
            "$type": "duration",
            "$value": {
              "unit": "ms",
              "value": 600
            }
          }
        },
        "border": {
          "radius": {
            "$value": "{border.radius.medium}"
          }
        },
        "color": {
          "$value": "{color.black.10}"
        }
      }
    },
    "circle": {
      "border": {
        "style": {
          "$value": "{border.style.default}"
        },
        "width": {
          "$value": "{border.size.medium}"
        }
      },
      "indeterminate": {
        "$type": "qtm.animation",
        "$value": {
          "duration": {
            "unit": "ms",
            "value": 1000
          },
          "interaction": {
            "count": {
              "value": {
                "value": "infinite"
              }
            }
          },
          "name": {
            "value": "loading"
          },
          "timing": {
            "function": {
              "value": {
                "value": "linear"
              }
            }
          }
        }
      },
      "large": {
        "size": {
          "$value": "{spacing.l}"
        }
      },
      "medium": {
        "size": {
          "$type": "dimension",
          "$value": {
            "unit": "rem",
            "value": 1.25
          }
        }
      },
      "neutral": {
        "lead": {
          "color": {
            "$value": "{color.bluegrey.900}"
          }
        }
      },
      "primary": {
        "lead": {
          "color": {
            "$value": "{color.primary.500}"
          }
        }
      },
      "small": {
        "size": {
          "$value": "{spacing.m}"
        }
      },
      "track": {
        "color": {
          "$value": "{color.black.10}"
        }
      },
      "white": {
        "lead": {
          "color": {
            "$value": "{color.bluegrey.25}"
          }
        },
        "track": {
          "color": {
            "$value": "{color.white.10}"
          }
        }
      },
      "xlarge": {
        "size": {
          "$value": "{spacing.xl}"
        }
      },
      "xsmall": {
        "size": {
          "$value": "{spacing.s}"
        }
      }
    }
  }
}
