{
  "header": {
    "brand": {
      "margin": {
        "right": {
          "$value": "{spacing.3xl}"
        }
      }
    },
    "container": {
      "background": {
        "color": {
          "$value": "{color.white.100}"
        }
      },
      "shadow": {
        "$value": "{shadow.s.light}"
      }
    },
    "divider": {
      "color": {
        "$value": "{color.bluegrey.100}"
      },
      "margin": {
        "right": {
          "$value": "{spacing.xxl}"
        }
      },
      "width": {
        "$value": "{border.size.thin}"
      }
    },
    "large": {
      "container": {
        "height": {
          "$value": "{spacing.7xl}"
        },
        "padding": {
          "left": {
            "$value": "{spacing.m}"
          },
          "right": {
            "$value": "{spacing.m}"
          }
        }
      },
      "divider": {
        "height": {
          "$value": "{spacing.3xl}"
        }
      },
      "logo": {
        "height": {
          "$type": "dimension",
          "$value": {
            "unit": "rem",
            "value": 3.25
          }
        }
      },
      "product": {
        "name": {
          "font": {
            "size": {
              "$value": "{font.scale.6.size}"
            }
          },
          "line": {
