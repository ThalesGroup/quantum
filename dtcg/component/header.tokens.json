          "$value": "{spacing.xl}"
        }
      },
      "logo": {
        "height": {
          "$type": "dimension",
          "$value": {
            "unit": "rem",
            "value": 1.75
          }
        }
      },
      "product": {
        "name": {
          "font": {
            "size": {
              "$value": "{font.scale.8.size}"
            }
          },
          "line": {
            "height": {
              "$value": "{font.scale.8.line.height}"
            }
          }
        }
