              "$value": "{font.scale.6.line.height}"
            }
          }
        }
      }
    },
    "medium": {
      "container": {
        "height": {
          "$value": "{spacing.5xl}"
        },
        "padding": {
          "left": {
            "$value": "{spacing.s}"
          },
          "right": {
            "$value": "{spacing.s}"
          }
        }
      },
      "divider": {
        "height": {
          "$value": "{spacing.xxl}"
        }
      },
      "logo": {
        "height": {
          "$value": "{spacing.xxl}"
        }
      },
      "product": {
        "name": {
          "font": {
            "size": {
              "$value": "{font.scale.7.size}"
            },
            "weight": {
              "$value": "{font.weight.medium}"
            }
          }
        }
      }
    },
    "menu": {
