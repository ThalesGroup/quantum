{
  "divider": {
    "color": {
      "$value": "{color.bluegrey.100}"
    },
    "large": {
      "height": {
        "$value": "{border.size.thick}"
      }
    },
    "medium": {
      "height": {
        "$value": "{border.size.medium}"
      }
    },
    "rounded": {
      "radius": {
        "$value": "{border.radius.full}"
      }
    },
    "sharpe": {
      "radius": {
        "$value": "{border.radius.none}"
      }
    },
    "small": {
      "height": {
        "$value": "{border.size.thin}"
      }
    }
  }
}
