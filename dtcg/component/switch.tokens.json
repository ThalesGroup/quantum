          }
        },
        "shadow": {
          "$value": "{shadow.xs.ultralight}"
        }
      },
      "disabled": {
        "button": {
          "shadow": {
            "$type": "qtm.other",
            "$value": "none"
          }
        },
        "off": {
          "background": {
            "color": {
              "$value": "{color.bluegrey.50}"
            }
          },
          "button": {
            "background": {
              "color": {
