                  "unit": "rem",
                  "value": 1.125
                }
              }
            }
          }
        },
        "medium": {
          "button": {
            "padding": {
              "left": {
                "$type": "dimension",
                "$value": {
                  "unit": "rem",
                  "value": 0.875
                }
              }
            }
          }
        },
        "small": {
          "button": {
            "padding": {
              "left": {
                "$type": "dimension",
                "$value": {
                  "unit": "rem",
                  "value": 0.625
                }
              }
            }
          }
        }
      },
      "pressed": {
        "button": {
          "shadow": {
            "$type": "qtm.other",
            "$value": "none"
          }
        }
      },
      "small": {
        "border": {
          "radius": {
            "$value": "{border.radius.full}"
          }
        },
        "button": {
          "border": {
            "radius": {
              "$value": "{border.radius.circle}"
            }
          },
          "size": {
            "$value": "{spacing.s}"
          }
        },
        "height": {
          "$value": "{spacing.m}"
        },
        "icon": {
          "size": {
            "$value": "{spacing.xs}"
          }
        },
        "width": {
          "$value": "{spacing.l}"
        }
      },
      "transition": {
        "$type": "qtm.transition",
        "$value": {
          "delay": {
            "unit": "ms",
            "value": 0
          },
          "duration": {
            "unit": "ms",
            "value": 200
          },
          "properties": [
            "background-color",
            "padding-left",
            "padding-right"
          ],
          "timingFunction": "ease-in"
        }
      }
