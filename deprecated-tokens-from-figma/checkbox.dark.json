{
  "checkbox": {
    "focus": {
      "ring": {
        "border": { "color": { "value": "{color.dark.primary.200.value}" } }
      }
    },
    "caption": { "color": { "value": "{color.bluegrey.300.value}" } },
    "label": { "color": { "value": "{color.bluegrey.25.value}" } },
    "background": { "color": { "value": "{color.bluegrey.900.value}" } },
    "error": {
      "border": { "color": { "value": "{color.dark.red.500.value}" } }
    },
    "checked": {
      "background": { "color": { "value": "{color.dark.primary.400.value}" } },
      "hover": {
        "background": { "color": { "value": "{color.dark.primary.300.value}" } }
      },
      "pressed": {
        "background": { "color": { "value": "{color.dark.primary.200.value}" } }
      },
      "disabled": {
        "background": { "color": { "value": "{color.bluegrey.800.value}" } }
      }
    },
    "neutral": {
      "checked": {
        "background": { "color": { "value": "{color.bluegrey.400.value}" } },
        "hover": {
          "background": { "color": { "value": "{color.bluegrey.300.value}" } }
        },
        "pressed": {
          "background": { "color": { "value": "{color.bluegrey.200.value}" } }
        }
      }
    },
    "unchecked": {
      "border": { "color": { "value": "{color.bluegrey.400.value}" } },
      "hover": {
        "border": { "color": { "value": "{color.bluegrey.300.value}" } },
        "background": { "color": { "value": "{color.white.10.value}" } }
      },
      "pressed": {
        "border": { "color": { "value": "{color.bluegrey.200.value}" } },
        "background": { "color": { "value": "{color.bluegrey.100.value}" } }
      },
      "disabled": {
        "border": { "color": { "value": "{color.white.20.value}" } },
        "background": { "color": { "value": "{color.bluegrey.900.value}" } }
      }
    }
  }
}
