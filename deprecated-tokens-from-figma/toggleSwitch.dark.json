{
  "switch": {
    "input": {
      "off": {
        "background": { "color": { "value": "{color.bluegrey.800.value}" } }
      },
      "on": {
        "background": { "color": { "value": "{color.dark.primary.400.value}" } }
      },
      "neutral": {
        "on": {
          "background": { "color": { "value": "{color.bluegrey.400.value}" } }
        },
        "button": {
          "icon": { "color": { "value": "{color.bluegrey.400.value}" } }
        }
      },
      "button": {
        "background": { "color": { "value": "{color.bluegrey.25.value}" } },
        "icon": { "color": { "value": "{color.dark.primary.400.value}" } }
      },
      "disabled": {
        "off": {
          "button": {
            "icon": { "color": { "value": "{color.bluegrey.800.value}" } }
          },
          "background": { "color": { "value": "{color.bluegrey.800.value}" } }
        },
        "on": {
          "button": {
            "background": { "color": { "value": "{color.bluegrey.800.value}" } }
          }
        }
      },
      "focus": {
        "ring": {
          "border": { "color": { "value": "{color.dark.primary.200.value}" } }
        }
      }
    },
    "label": { "color": { "value": "{color.bluegrey.25.value}" } }
  }
}
