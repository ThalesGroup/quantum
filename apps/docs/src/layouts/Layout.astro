---
import { getTemplate } from '../lib/web';
import { getCollection } from 'astro:content';
import '../styles/site.css';
import Status from '../components/Status.astro';
import { getModes } from '../lib/tokens';
import { getScreens, getSections } from '../lib/screens';
// The design system itself: the tokens package, then the web reference implementation (packages/components/src/,
// not published: @quantum-ds/components ships only the specs).
import '@quantum-ds/tokens/css/index.css';
import '../../../../packages/components/src/index.css';

interface Props {
  title: string;
  description?: string;
  /** Which sidebar the page shows: foundations and components (default), or the screens by section. */
  sidebar?: 'catalog' | 'screens';
}
const { title, description, sidebar = 'catalog' } = Astro.props;
// Screens sidebar: the sections of screens/sections.json, each with its screens.
const screens = getScreens();
const screenSections = getSections().map((s) => ({ ...s, screens: screens.filter((x) => x.meta.section === s.id) })).filter((s) => s.screens.length);
const specs = (await getCollection('specs')).sort((a, b) => a.data.name.localeCompare(b.data.name));
// Foundations in the order their docs give (frontmatter `order`), then by name.
const foundationOrder = new Map((await getCollection('foundationDocs')).map((d) => [d.data.foundation, d.data.order ?? Infinity]));
const foundations = (await getCollection('foundations')).sort((a, b) => (foundationOrder.get(a.id) ?? Infinity) - (foundationOrder.get(b.id) ?? Infinity) || a.data.name.localeCompare(b.data.name));
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const current = Astro.url.pathname.replace(/\/$/, '');
const isActive = (href: string) => current === `${base}${href}`.replace(/\/$/, '');
// A component stays highlighted in the sidebar on every one of its tab pages.
const isWithin = (href: string) => isActive(href) || current.startsWith(`${base}${href}/`);
// Color mode switch: the modes of tokens.config.json plus "auto" (follows the system), applied
// through the design system's own web context attribute on <html>. Remembered per browser.
const { modes, attribute, auto } = getModes();
const choices = [...(auto ? [{ value: auto, label: 'Auto' }] : []), ...modes.map((m) => ({ value: m.id, label: m.id[0].toUpperCase() + m.id.slice(1) }))];
const initial = auto ?? modes.find((m) => m.default)?.id ?? null;
const htmlAttrs = attribute && initial ? { [attribute]: initial } : {};
---
<!doctype html>
<html lang="en" {...htmlAttrs}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Quantum Design System</title>
    {description ? <meta name="description" content={description} /> : null}
    {attribute && choices.length > 1 ? (
      <script is:inline define:vars={{ attribute, values: choices.map((c) => c.value) }}>
        // Before first paint: restore the mode chosen on a previous visit.
        try {
          const saved = localStorage.getItem('site-mode');
          if (values.includes(saved)) document.documentElement.setAttribute(attribute, saved);
        } catch {}
      </script>
    ) : null}
  </head>
  <body class="site">
    <a class="site-skip" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="site-brand" href={`${base}/`}><span class="site-brand__mark" aria-hidden="true"></span><span class="site-brand__text">Quantum</span></a>
      <nav class="site-header__nav" aria-label="Primary">
        <a href={`${base}/`} aria-current={isActive('/') ? 'page' : undefined}>Components</a>
        <a href={`${base}/screens`} aria-current={isActive('/screens') ? 'page' : isWithin('/screens') ? 'true' : undefined}>Screens</a>
        <a href={`${base}/foundations`} aria-current={isActive('/foundations') ? 'page' : isWithin('/foundations') ? 'true' : undefined}>Foundations</a>
        <a href={`${base}/tokens`} aria-current={isActive('/tokens') ? 'page' : isWithin('/tokens') ? 'true' : undefined}>Tokens</a>
        <a href={`${base}/platforms`} aria-current={isActive('/platforms') ? 'page' : undefined}>Platforms</a>
        <a href={`${base}/modes`} aria-current={isActive('/modes') ? 'page' : undefined}>Modes</a>
        <a href={`${base}/about`} aria-current={isActive('/about') ? 'page' : undefined}>How it works</a>
      </nav>
      {attribute && choices.length > 1 ? (
        <div class="site-mode-switch" set:html={getTemplate('select')?.render({ label: 'Mode', id: 'site-mode-switch', size: 'small', options: choices.map((c) => ({ label: c.label, value: c.value, selected: c.value === initial })), attrs: { 'data-mode-switch': attribute } })}></div>
      ) : null}
    </header>
    <div class="site-shell">
      <aside class="site-sidebar" aria-label={sidebar === 'screens' ? 'Screens' : 'Components and foundations'}>
        <div class="site-sidebar__inner">
          {sidebar === 'screens' ? (
            <>
              <ul class="site-sidebar__list site-sidebar__list--group">
                <li><a href={`${base}/screens`} aria-current={isActive('/screens') ? 'page' : undefined}>Overview</a></li>
                <li><a href={`${base}/screens/sources`} aria-current={isActive('/screens/sources') ? 'page' : undefined}>Sources and licences</a></li>
              </ul>
              {screenSections.map((section) => (
                <>
                  <p class="site-sidebar__title">{section.name}</p>
                  <ul class="site-sidebar__list site-sidebar__list--group">
                    {section.screens.map((s) => (
                      <li><a href={`${base}/screens/${s.id}`} aria-current={isActive(`/screens/${s.id}`) ? 'page' : undefined}>{s.meta.name}</a></li>
                    ))}
                  </ul>
                </>
              ))}
            </>
          ) : null}
          {sidebar === 'catalog' && foundations.length ? (
            <>
              <p class="site-sidebar__title">Foundations</p>
              <ul class="site-sidebar__list site-sidebar__list--group">
                {foundations.map((f) => (
                  <li>
                    <a href={`${base}/foundations/${f.id}`} aria-current={isActive(`/foundations/${f.id}`) ? 'page' : isWithin(`/foundations/${f.id}`) ? 'true' : undefined}>
                      {f.data.name}
                      <Status status={f.data.status} compact />
                    </a>
                  </li>
                ))}
              </ul>
            </>
          ) : null}
          {sidebar === 'catalog' ? (
            <>
              <p class="site-sidebar__title">Components</p>
              <ul class="site-sidebar__list">
                {specs.map((s) => (
                  <li>
                    <a href={`${base}/components/${s.id}`} aria-current={isActive(`/components/${s.id}`) ? 'page' : isWithin(`/components/${s.id}`) ? 'true' : undefined}>
                      {s.data.name}
                      <Status status={s.data.status} compact />
                    </a>
                  </li>
                ))}
              </ul>
            </>
          ) : null}
        </div>
      </aside>
      <main id="main" class="site-main">
        {/* Every page says the design system shown here is Quantum NextGen, still experimental: the design system's Alert. */}
        <div class="site-banner" set:html={getTemplate('alert')?.render({ intent: 'warning', title: 'Experimental: Quantum NextGen', message: 'This site documents Quantum NextGen, the next major version of the Quantum Design System. Its components, tokens and packages are experimental and may change or break at any time without notice: do not use them in production yet.' })}></div>
        <slot />
      </main>
    </div>
    <script>
      // Header mode switch: set the context attribute on <html> and remember the choice.
      const select = document.querySelector<HTMLSelectElement>('[data-mode-switch]');
      if (select) {
        const attribute = select.dataset.modeSwitch!;
        select.value = document.documentElement.getAttribute(attribute) ?? select.value;
        select.addEventListener('change', () => {
          document.documentElement.setAttribute(attribute, select.value);
          try { localStorage.setItem('site-mode', select.value); } catch {}
        });
      }
    </script>
  </body>
</html>
