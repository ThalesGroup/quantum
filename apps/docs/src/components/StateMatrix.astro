---
/**
 * Options of one enum property (rows) x the states of one part (columns).
 * States are forced through the template's `state` prop -> data-state attribute; a part repeated
 * through a list property gets the state on its single entry (lib/matrix.ts cellProps).
 * Only the states of the web are drawn, by the reference rendering; the others are listed under the table. Each column says which
 * inputs or platforms the state belongs to (from the spec).
 */
import type { Template } from '../lib/web';
import { scopeLabel, stateOn } from '../lib/platforms';
import { cellProps, type PartMatrix } from '../lib/matrix';
import { onBackdrop } from '../lib/backdrop';
interface Props {
  spec: any;
  template: Template;
  matrix: PartMatrix;
  property: any;
  fixed: { property: any; value: string }[];
  baseProps: Record<string, unknown>;
}
const { spec, template, matrix, property, fixed, baseProps } = Astro.props;
const platform = 'web';
const all = matrix.states as { id: string; inputs?: string[]; platforms?: string[] }[];
const states = all.filter((s) => stateOn(s, platform));
const elsewhere = all.filter((s) => !stateOn(s, platform));
// A cell is drawn on the fill it sits on when it reads a role on one (lib/backdrop.ts).
const cell = (value: string, state: string) => {
  const props = cellProps(spec, matrix, baseProps, { property, value }, fixed, state);
  return onBackdrop(spec, template.render(props), props, state);
};
const scope = (s: { inputs?: string[]; platforms?: string[] }) => [s.inputs?.length ? s.inputs.join(', ') : '', scopeLabel(s)].filter(Boolean).join(' · ');
---
<div class="site-matrix-wrap">
  <table class="site-matrix">
    <thead>
      <tr>
        <th scope="col">{property.name ?? property.id}</th>
        {states.map((s) => <th scope="col">{s.id}{scope(s) ? <span class="site-matrix__scope">{scope(s)}</span> : null}</th>)}
      </tr>
    </thead>
    <tbody>
      {property.options.map((o: any) => (
        <tr>
          <th scope="row"><code>{o.value}</code></th>
          {states.map((s) => (
            <td>
              <div class="site-matrix__cell" set:html={cell(o.value, s.id)}></div>
            </td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
</div>
{elsewhere.length ? (
  <p class="site-muted site-small">Not on the web: {elsewhere.map((s) => <span class="site-chip"><code>{s.id}</code> <span class="site-muted">{scopeLabel(s)}</span></span>)}</p>
) : null}
