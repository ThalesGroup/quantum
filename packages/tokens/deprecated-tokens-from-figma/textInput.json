{
  "input": {
    "font": {
      "family": { "value": "{font.family.roboto.value}" },
      "weight": { "value": "{font.weight.regular.value}" }
    },
    "text": { "color": { "value": "{color.bluegrey.900.value}" } },
    "placeholder": { "color": { "value": "{color.bluegrey.500.value}" } },
    "border": {
      "width": { "value": "{border.size.thin.value}" },
      "style": { "value": "{border.style.default.value}" },
      "color": { "value": "{color.bluegrey.500.value}" },
      "radius": { "value": "{border.radius.medium.value}" }
    },
    "background": { "color": { "value": "{color.white.100.value}" } },
    "icon": {
      "color": { "value": "{color.bluegrey.900.value}" },
      "success": { "color": { "value": "{color.green.500.value}" } },
      "warning": { "color": { "value": "{color.orange.500.value}" } },
      "error": { "color": { "value": "{color.red.500.value}" } }
    },
    "disabled": {
      "icon": { "color": { "value": "{color.bluegrey.400.value}" } },
      "background": { "color": { "value": "{color.bluegrey.25.value}" } },
      "border": { "color": { "value": "{color.bluegrey.100.value}" } },
      "text": { "color": { "value": "{color.bluegrey.400.value}" } }
    },
    "default": {
      "icon": { "left": { "color": { "value": "{color.bluegrey.500.value}" } } }
    },
    "hover": {
      "icon": { "color": { "value": "{color.bluegrey.500.value}" } },
      "background": { "color": { "value": "{color.bluegrey.25.value}" } }
    },
    "small": {
      "height": { "value": "{spacing.xl.value}" },
      "font": { "size": { "value": "{font.scale.8.size.value}" } },
      "line": { "height": { "value": "{font.scale.8.line.height.value}" } },
      "padding": {
        "top": { "value": "{spacing.xs.value}" },
        "left": { "value": "{spacing.xs.value}" },
        "bottom": { "value": "{spacing.xs.value}" },
        "right": { "value": "{spacing.xs.value}" }
      },
      "icon": {
        "size": { "value": "{spacing.m.value}" },
        "left": { "margin": { "right": { "value": "{spacing.xxs.value}" } } },
        "right": { "margin": { "left": { "value": "{spacing.xs.value}" } } }
      }
    },
    "medium": {
      "height": { "value": "{spacing.xxl.value}" },
      "font": { "size": { "value": "{font.scale.7.size.value}" } },
      "line": { "height": { "value": "{font.scale.7.line.height.value}" } },
      "padding": {
        "top": { "value": "{spacing.s.value}" },
        "left": { "value": "{spacing.xs.value}" },
        "bottom": { "value": "{spacing.s.value}" },
        "right": { "value": "{spacing.xs.value}" }
      },
      "icon": {
        "size": { "value": "1.25rem" },
        "left": { "margin": { "right": { "value": "{spacing.xxs.value}" } } },
        "right": { "margin": { "left": { "value": "{spacing.xs.value}" } } }
      }
    },
    "large": {
      "height": { "value": "{spacing.3xl.value}" },
      "font": { "size": { "value": "{font.scale.6.size.value}" } },
      "line": { "height": { "value": "{font.scale.6.line.height.value}" } },
      "padding": {
        "top": { "value": "{spacing.s.value}" },
        "left": { "value": "{spacing.xs.value}" },
        "bottom": { "value": "{spacing.s.value}" },
        "right": { "value": "{spacing.xs.value}" }
      },
      "icon": {
        "size": { "value": "{spacing.l.value}" },
        "left": { "margin": { "right": { "value": "{spacing.xxs.value}" } } },
        "right": { "margin": { "left": { "value": "{spacing.xs.value}" } } }
      }
    },
    "focus": {
      "border": { "color": { "value": "{color.primary.500.value}" } }
    },
    "error": { "border": { "color": { "value": "{color.red.500.value}" } } },
    "warning": {
      "border": { "color": { "value": "{color.orange.500.value}" } }
    }
  }
}
