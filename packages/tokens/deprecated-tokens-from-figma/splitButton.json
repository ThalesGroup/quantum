{
  "splitbutton": {
    "action": {
      "border": {
        "top": {
          "right": { "radius": { "value": "{border.radius.none.value}" } }
        },
        "bottom": {
          "right": { "radius": { "value": "{border.radius.none.value}" } }
        }
      },
      "margin": { "right": { "value": "{spacing.3xs.value}" } }
    },
    "dropdown": {
      "trigger": {
        "border": {
          "top": {
            "left": { "radius": { "value": "{border.radius.none.value}" } }
          },
          "bottom": {
            "left": { "radius": { "value": "{border.radius.none.value}" } }
          }
        }
      }
    }
  }
}
