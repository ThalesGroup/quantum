{
  "switch": {
    "label": {
      "font": {
        "family": { "value": "{font.family.roboto.value}" },
        "weight": { "value": "{font.weight.regular.value}" }
      },
      "small": {
        "font": { "size": { "value": "{font.scale.8.size.value}" } },
        "line": { "height": { "value": "{font.scale.8.line.height.value}" } }
      },
      "medium": {
        "font": { "size": { "value": "{font.scale.7.size.value}" } },
        "line": { "height": { "value": "{font.scale.7.line.height.value}" } }
      },
      "large": {
        "font": { "size": { "value": "{font.scale.6.size.value}" } },
        "line": { "height": { "value": "{font.scale.6.line.height.value}" } }
      },
      "color": { "value": "{color.bluegrey.900.value}" },
      "disabled": { "color": { "value": "{color.bluegrey.400.value}" } }
    },
    "input": {
      "margin": { "horizontal": { "value": "{spacing.xs.value}" } },
      "small": {
        "height": { "value": "{spacing.m.value}" },
        "width": { "value": "{spacing.l.value}" },
        "button": {
          "size": { "value": "{spacing.s.value}" },
          "border": { "radius": { "value": "{border.radius.circle.value}" } }
        },
        "border": { "radius": { "value": "{border.radius.full.value}" } },
        "icon": { "size": { "value": "{spacing.xs.value}" } }
      },
      "medium": {
        "height": { "value": "1.25rem" },
        "width": { "value": "{spacing.xl.value}" },
        "button": {
          "size": { "value": "{spacing.m.value}" },
          "border": { "radius": { "value": "{border.radius.circle.value}" } }
        },
        "border": { "radius": { "value": "{border.radius.full.value}" } },
        "icon": { "size": { "value": "{spacing.s.value}" } }
      },
      "large": {
        "height": { "value": "{spacing.l.value}" },
        "width": { "value": "{spacing.xxl.value}" },
        "button": {
          "size": { "value": "1.25rem" },
          "border": { "radius": { "value": "{border.radius.circle.value}" } }
        },
        "border": { "radius": { "value": "{border.radius.full.value}" } },
        "icon": { "size": { "value": "{spacing.m.value}" } }
      },
      "off": {
        "background": { "color": { "value": "{color.bluegrey.100.value}" } },
        "button": { "padding": { "left": { "value": "{spacing.3xs.value}" } } },
        "small": {
          "button": { "padding": { "right": { "value": "0.625rem" } } }
        },
        "medium": {
          "button": { "padding": { "right": { "value": "0.875rem" } } }
        },
        "large": {
          "button": { "padding": { "right": { "value": "1.125rem" } } }
        }
      },
      "on": {
        "background": { "color": { "value": "{color.primary.500.value}" } },
        "small": {
          "button": { "padding": { "left": { "value": "0.625rem" } } }
        },
        "medium": {
          "button": { "padding": { "left": { "value": "0.875rem" } } }
        },
        "large": {
          "button": { "padding": { "left": { "value": "1.125rem" } } }
        },
        "button": { "padding": { "right": { "value": "{spacing.3xs.value}" } } }
      },
      "neutral": {
        "on": {
          "background": { "color": { "value": "{color.bluegrey.500.value}" } }
        },
        "button": {
          "icon": { "color": { "value": "{color.bluegrey.500.value}" } }
        }
      },
      "button": {
        "background": { "color": { "value": "{color.bluegrey.25.value}" } },
        "icon": { "color": { "value": "{color.primary.500.value}" } },
        "shadow": { "value": "{shadow.xs.ultralight.value}" },
        "padding": { "vertical": { "value": "{spacing.3xs.value}" } }
      },
      "disabled": {
        "off": {
          "button": {
            "icon": { "color": { "value": "{color.bluegrey.50.value}" } },
            "background": { "color": { "value": "{color.bluegrey.400.value}" } }
          },
          "background": { "color": { "value": "{color.bluegrey.50.value}" } }
        },
        "on": {
          "button": {
            "icon": { "color": { "value": "{color.bluegrey.400.value}" } },
            "background": { "color": { "value": "{color.bluegrey.50.value}" } }
          },
          "background": { "color": { "value": "{color.bluegrey.400.value}" } }
        },
        "button": { "shadow": { "value": "none" } }
      },
      "pressed": { "button": { "shadow": { "value": "none" } } },
      "focus": {
        "ring": {
          "width": { "value": "{border.size.medium.value}" },
          "offset": { "width": { "value": "{spacing.3xs.value}" } },
          "border": { "color": { "value": "{color.primary.200.value}" } }
        }
      },
      "transition": {
        "property": {
          "value": "background-color, padding-left, padding-right"
        },
        "duration": { "value": "200ms" },
        "delay": { "value": "0ms" },
        "timing": { "value": "ease-in" }
      }
    }
  }
}
