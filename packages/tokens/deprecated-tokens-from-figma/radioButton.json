      "checked": { "symbol": { "size": { "value": "0.875rem" } } },
      "label": {
        "font": {
          "size": { "value": "{font.scale.7.size.value}" },
          "weight": { "value": "{font.weight.medium.value}" }
        },
        "line": { "height": { "value": "{font.scale.7.line.height.value}" } }
      }
    },
    "label": {
      "font": { "family": { "value": "{font.family.roboto.value}" } },
      "color": { "value": "{color.bluegrey.900.value}" }
    },
    "large": {
      "input": { "size": { "value": "{spacing.l.value}" } },
      "checked": { "symbol": { "size": { "value": "1.125rem" } } },
      "label": {
        "font": {
          "size": { "value": "{font.scale.6.size.value}" },
