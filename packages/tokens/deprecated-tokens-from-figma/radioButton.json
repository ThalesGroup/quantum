        "color": { "value": "{color.bluegrey.500.value}" }
      },
      "background": { "color": { "value": "{color.bluegrey.25.value}" } },
      "checked": {
        "symbol": {
          "background": { "color": { "value": "{color.primary.500.value}" } }
        },
        "hover": {
          "symbol": {
            "background": { "color": { "value": "{color.primary.600.value}" } }
          }
        },
        "pressed": {
          "symbol": {
            "background": { "color": { "value": "{color.primary.700.value}" } }
