      },
      "pressed": {
        "background": { "color": { "value": "{color.bluegrey.100.value}" } },
        "border": { "color": { "value": "{color.bluegrey.700.value}" } }
      },
      "ring": {
        "color": { "value": "{color.primary.200.value}" },
        "offset": { "width": { "value": "{spacing.3xs.value}" } },
        "width": { "value": "{border.size.medium.value}" }
      }
    },
    "neutral": {
      "input": {
        "checked": {
          "symbol": {
            "background": { "color": { "value": "{color.bluegrey.500.value}" } }
          },
          "hover": {
            "symbol": {
              "background": {
                "color": { "value": "{color.bluegrey.600.value}" }
              }
            }
          },
          "pressed": {
            "symbol": {
