  "radiogroup": {
    "small": {
      "radio": { "margin": { "bottom": { "value": "{spacing.xs.value}" } } }
    },
    "medium": {
      "radio": { "margin": { "bottom": { "value": "{spacing.s.value}" } } }
    },
