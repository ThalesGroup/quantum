          "size": { "value": "{font.scale.8.size.value}" },
          "weight": { "value": "{font.weight.medium.value}" }
        },
        "line": { "height": { "value": "{font.scale.8.line.height.value}" } }
      }
    },
    "medium": {
      "small": { "margin": { "right": { "value": "{spacing.xs.value}" } } },
