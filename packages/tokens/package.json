{
  "name": "@quantum-ds/tokens",
  "version": "2.0.0-alpha.0",
  "description": "Quantum design tokens: DTCG sources in three tiers (raw, semantic, component) with platform and mode overlays, built into CSS, Sass, JavaScript, Android, Figma, Penpot and Tokens Studio formats",
  "author": "Quantum Core Team",
  "license": "MIT",
  "homepage": "https://github.com/ThalesGroup/quantum/tree/main/packages/tokens#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThalesGroup/quantum.git",
    "directory": "packages/tokens"
  },
  "bugs": {
    "url": "https://github.com/ThalesGroup/quantum/issues"
  },
  "keywords": [
    "design-tokens",
    "dtcg",
    "design-system",
    "css-custom-properties",
    "style-dictionary"
  ],
  "main": "dist/tokens-es6.js",
  "types": "dist/tokens-es6.d.ts",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/tokens-es6.d.ts",
      "style": "./dist/css/index.css",
      "default": "./dist/tokens-es6.js"
    },
    "./css/*": "./dist/css/*",
    "./platforms/*": "./dist/platforms/*",
    "./shiki-theme.json": "./dist/shiki-theme.json",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "style": "dist/css/index.css",
  "files": [
    "CHANGELOG.md",
    "dist",
    "!dist/figma",
    "!dist/tokens_studio"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && node ../../scripts/build-tokens.mjs && node style-dictionary.config.mjs",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "style-dictionary": "^5.7.0"
  }
}
