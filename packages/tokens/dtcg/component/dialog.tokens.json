{
  "dialog": {
    "background": {
      "color": {
        "$value": "{color.white.100}"
      },
      "shadow": {
        "$value": "{shadow.xl.light}"
      }
    },
    "body": {
      "font": {
        "size": {
          "$value": "{font.scale.7.size}"
        }
      },
      "line": {
        "height": {
          "$value": "{font.scale.7.line.height}"
        }
      },
      "padding": {
        "bottom": {
          "$value": "{spacing.l}"
        },
        "horizontal": {
          "$value": "{spacing.l}"
        }
      }
    },
    "breakpoint": {
      "large": {
        "width": {
          "$type": "qtm.other",
          "$value": "50%"
        }
      },
      "medium": {
        "width": {
          "$type": "qtm.other",
          "$value": "50%"
        }
      },
      "small": {
        "width": {
          "$type": "qtm.other",
          "$value": "calc(100vw - 32px)"
        }
      },
      "xlarge": {
        "width": {
          "$type": "qtm.other",
          "$value": "50%"
        }
      },
      "xsmall": {
        "width": {
          "$type": "qtm.other",
          "$value": "calc(100vw - 32px)"
        }
      },
      "xxsmall": {
        "width": {
          "$type": "qtm.other",
          "$value": "calc(100vw - 32px)"
        }
      }
    },
    "buttongroup": {
      "margin": {
        "$value": "{spacing.xs}"
      }
    },
    "divider": {
      "background": {
        "color": {
          "$value": "{color.bluegrey.100}"
        }
      },
      "size": {
        "$type": "dimension",
        "$value": {
          "unit": "px",
          "value": 1
        }
      }
    },
    "font": {
      "family": {
        "$value": "{font.family.roboto}"
      }
    },
    "footer": {
      "padding": {
        "horizontal": {
          "$value": "{spacing.l}"
        },
        "vertical": {
          "$value": "{spacing.m}"
        }
      }
    },
    "header": {
      "large": {
        "title": {
          "font": {
            "size": {
              "$value": "{font.scale.4.size}"
            }
          },
          "line": {
            "height": {
              "$value": "{font.scale.4.line.height}"
            }
          }
        }
      },
      "medium": {
        "title": {
          "font": {
            "size": {
              "$value": "{font.scale.5.size}"
            }
          },
          "line": {
            "height": {
              "$value": "{font.scale.5.line.height}"
            }
          }
        }
      },
      "padding": {
        "horizontal": {
          "$value": "{spacing.l}"
        },
        "vertical": {
          "$value": "{spacing.m}"
        }
      },
      "small": {
        "title": {
          "font": {
            "size": {
              "$value": "{font.scale.6.size}"
            }
          },
          "line": {
            "height": {
              "$value": "{font.scale.6.line.height}"
            }
          }
        }
      },
      "subtitle": {
        "color": {
          "$value": "{color.bluegrey.500}"
        },
        "font": {
          "size": {
            "$value": "{font.scale.9.size}"
          }
        },
        "line": {
          "height": {
            "$value": "{font.scale.9.line.height}"
          }
        }
      },
      "title": {
        "color": {
          "$value": "{color.bluegrey.900}"
        }
      }
    },
    "max": {
      "height": {
        "$type": "qtm.other",
        "$value": "calc(100vh - 16px)"
      }
    },
    "overlay": {
      "background": {
        "color": {
          "$value": "{color.black.30}"
        }
      }
    }
  }
}
