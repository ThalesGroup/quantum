{
  "input": {
    "background": {
      "color": {
        "$value": "{color.black.100}"
      }
    },
    "border": {
      "color": {
        "$value": "{color.bluegrey.400}"
      }
    },
    "default": {
      "icon": {
        "left": {
          "color": {
            "$value": "{color.bluegrey.400}"
          }
        }
      }
    },
    "disabled": {
      "background": {
        "color": {
          "$value": "{color.bluegrey.800}"
        }
      },
      "border": {
        "color": {
          "$value": "{color.bluegrey.400}"
        }
      }
    },
    "error": {
      "border": {
        "color": {
          "$value": "{color.dark.red.500}"
        }
      }
    },
    "focus": {
      "border": {
        "color": {
          "$value": "{color.dark.primary.400}"
        }
      }
    },
    "hover": {
      "background": {
        "color": {
          "$value": "{color.white.10}"
        }
      },
      "icon": {
        "color": {
          "$value": "{color.bluegrey.400}"
        }
      }
    },
    "icon": {
      "color": {
        "$value": "{color.bluegrey.25}"
      }
    },
    "placeholder": {
      "color": {
        "$value": "{color.bluegrey.400}"
      }
    },
    "text": {
      "color": {
        "$value": "{color.bluegrey.25}"
      }
    },
    "warning": {
      "border": {
        "color": {
          "$value": "{color.dark.orange.500}"
        }
      }
    }
  }
}
