{
  "tabs": {
    "divider": {
      "border": {
        "color": {
          "$value": "{color.bluegrey.800}"
        }
      }
    },
    "tab": {
      "active": {
        "label": {
          "color": {
            "$value": "{color.bluegrey.25}"
          }
        }
      },
      "activebar": {
        "background": {
          "color": {
            "$value": "{color.dark.primary.400}"
          }
        }
      },
      "disabled": {
        "background": {
          "color": {
            "$value": "{color.bluegrey.900}"
          }
        }
      },
      "focus": {
        "border": {
          "color": {
            "$value": "{color.dark.primary.200}"
          }
        }
      },
      "hover": {
        "background": {
          "color": {
            "$value": "{color.white.10}"
          }
        }
      },
      "label": {
        "color": {
          "$value": "{color.bluegrey.25}"
        }
      },
      "pressed": {
        "background": {
          "color": {
            "$value": "{color.white.20}"
          }
        }
      }
    }
  }
}
