{
  "itemlist": {
    "item": {
      "active": {
        "background": {
          "color": {
            "$type": "color",
            "$value": {
              "alpha": 0,
              "colorSpace": "srgb",
              "components": [
                0,
                0,
                0
              ]
            }
          }
        },
        "label": {
          "color": {
            "$value": "{color.primary.500}"
          }
        }
      },
      "activebar": {
        "background": {
          "color": {
            "$value": "{color.primary.500}"
          }
        },
        "border": {
          "right": {
            "radius": {
              "$value": "{border.radius.medium}"
            }
          }
        },
        "width": {
          "$value": "{border.size.thick}"
        }
      },
      "background": {
        "color": {
          "$type": "color",
          "$value": {
            "alpha": 0,
            "colorSpace": "srgb",
            "components": [
              0,
              0,
              0
            ]
          }
        }
      },
      "disabled": {
        "background": {
          "color": {
            "$type": "color",
            "$value": {
              "alpha": 0,
              "colorSpace": "srgb",
              "components": [
                0,
                0,
                0
              ]
            }
          }
        },
        "label": {
          "color": {
            "$value": "{color.bluegrey.400}"
          }
        }
      },
      "focus": {
        "border": {
          "color": {
            "$value": "{color.primary.200}"
          },
          "radius": {
            "$value": "{border.radius.medium}"
          },
          "type": {
            "$value": "{border.style.default}"
          },
          "width": {
            "$value": "{border.size.medium}"
          }
        }
      },
      "font": {
        "family": {
          "$value": "{font.family.roboto}"
        },
        "weight": {
          "$value": "{font.weight.regular}"
        }
      },
      "hover": {
        "background": {
          "color": {
            "$value": "{color.bluegrey.50}"
          }
        }
      },
      "icon": {
        "left": {
          "margin": {
            "right": {
              "$value": "{spacing.xs}"
            }
          }
        },
        "right": {
          "margin": {
            "left": {
              "$value": "{spacing.xs}"
            }
          }
        }
      },
      "label": {
        "color": {
          "$value": "{color.bluegrey.900}"
        }
      },
      "large": {
        "font": {
          "size": {
            "$value": "{font.scale.6.size}"
          }
        },
        "height": {
          "$value": "{spacing.3xl}"
        },
        "icon": {
          "size": {
            "$value": "{icon.large.size}"
          }
        },
        "line": {
          "height": {
            "$value": "{font.scale.6.line.height}"
          }
        },
        "padding": {
          "vertical": {
            "$value": "{spacing.s}"
          }
        }
      },
      "medium": {
        "font": {
          "size": {
            "$value": "{font.scale.7.size}"
          }
        },
        "height": {
          "$value": "{spacing.xxl}"
        },
        "icon": {
          "size": {
            "$value": "{icon.medium.size}"
          }
        },
        "line": {
          "height": {
            "$value": "{font.scale.7.line.height}"
          }
        },
        "padding": {
          "vertical": {
            "$type": "dimension",
            "$value": {
              "unit": "rem",
              "value": 0.625
            }
          }
        }
      },
      "padding": {
        "horizontal": {
          "$value": "{spacing.s}"
        }
      },
      "pressed": {
        "background": {
          "color": {
            "$value": "{color.bluegrey.100}"
          }
        }
      },
      "small": {
        "font": {
          "size": {
            "$value": "{font.scale.8.size}"
          }
        },
        "height": {
          "$value": "{spacing.xl}"
        },
        "icon": {
          "size": {
            "$value": "{icon.small.size}"
          }
        },
        "line": {
          "height": {
            "$value": "{font.scale.8.line.height}"
          }
        },
        "padding": {
          "vertical": {
            "$value": "{spacing.xs}"
          }
        }
      }
    },
    "subitem": {
      "active": {
        "label": {
          "color": {
            "$value": "{color.bluegrey.900}"
          }
        }
      },
      "label": {
        "color": {
          "$value": "{color.bluegrey.500}"
        },
        "font": {
          "weight": {
            "$value": "{font.weight.medium}"
          }
        }
      },
      "large": {
        "height": {
          "$value": "{spacing.xxl}"
        },
        "padding": {
          "vertical": {
            "$value": "{spacing.xs}"
          }
        }
      },
      "medium": {
        "height": {
          "$value": "{spacing.xl}"
        },
        "padding": {
          "vertical": {
            "$value": "{spacing.xs}"
          }
        }
      },
      "small": {
        "height": {
          "$value": "{spacing.l}"
        },
        "padding": {
          "vertical": {
            "$value": "{spacing.xxs}"
          }
        }
      }
    }
  }
}
