{
  "$description": "Component tokens for Accordion. Path grammar: accordion.<part>.<property>[.<size>][.<state>]. Parts, options and states must exist in packages/components/specs/components/accordion.spec.json. Values alias semantic tokens only (Figma library mapped colors and scales, and the additions).",
  "accordion": {
    "item": {
      "border-color": {
        "$type": "color",
        "$value": "{global.border.level.on-level.0}"
      },
      "border-width": {
        "$type": "dimension",
        "$value": "{stroke-width.sm}"
      }
    },
    "trigger": {
      "$description": "The header people activate: the whole row, with the title and the chevron.",
      "min-height": {
        "$type": "dimension",
        "small": {
          "$value": "{space.40}"
        },
        "medium": {
          "$value": "{space.48}"
        }
      },
      "padding-inline": {
        "$type": "dimension",
        "$value": "{space.8}"
      },
      "padding-block": {
        "$type": "dimension",
        "$value": "{space.8}"
      },
      "gap": {
        "$type": "dimension",
        "$value": "{space.12}"
      },
      "border-radius": {
        "$type": "dimension",
        "$value": "{corner-radius.xs}"
      },
      "background": {
        "$type": "color",
        "default": {
          "$value": "{color.transparent}"
        },
        "hover": {
          "$value": "{global.bg.subtle.neutral.default}"
        },
        "active": {
          "$value": "{global.bg.subtle.neutral.hover}"
        }
      },
      "outline-width": {
        "$type": "dimension",
        "focus-visible": {
          "$value": "{focus.ring.width}"
        }
      },
      "outline-offset": {
        "$type": "dimension",
        "focus-visible": {
          "$value": "{focus.ring.offset}"
        }
      },
      "outline-color": {
        "$type": "color",
        "focus-visible": {
          "$value": "{color.focus.ring}"
        }
      },
      "transition": {
        "duration": {
          "$type": "duration",
          "$value": "{duration.fast}"
        },
        "easing": {
          "$type": "cubicBezier",
          "$value": "{easing.standard}"
        }
      }
    },
    "title": {
      "color": {
        "$type": "color",
        "$value": "{global.text.on-base.neutral.primary}"
      },
      "typography": {
        "$type": "typography",
        "small": {
          "$value": {
            "fontFamily": "{body.family}",
            "fontSize": "{body.size.sm}",
            "fontWeight": "{body.weight.medium}",
            "lineHeight": "{font.line-height.tight}",
            "letterSpacing": "{font.letter-spacing.normal}"
          }
        },
        "medium": {
          "$value": {
            "fontFamily": "{body.family}",
            "fontSize": "{body.size.md}",
            "fontWeight": "{body.weight.medium}",
            "lineHeight": "{font.line-height.tight}",
            "letterSpacing": "{font.letter-spacing.normal}"
          }
        }
      }
    },
    "indicator": {
      "$description": "Chevron glyph of the icon font at the end of the trigger; turned upside down when expanded. Inherits the title color.",
      "font-family": {
        "$type": "fontFamily",
        "$value": "{font.icon.family}"
      },
      "font-weight": {
        "$type": "fontWeight",
        "$value": "{font.icon.weight.light}"
      },
      "fill": {
        "$type": "number",
        "$value": "{font.icon.fill.off}"
      },
      "grade": {
        "$type": "number",
        "$value": "{font.icon.grade.normal}"
      },
      "optical-size": {
        "$type": "number",
        "$value": "{font.icon.optical-size.20}"
      },
      "size": {
        "$type": "dimension",
        "small": {
          "$value": "{size.3}"
        },
        "medium": {
          "$value": "{size.4}"
        }
      },
      "transition": {
        "duration": {
          "$type": "duration",
          "$value": "{duration.fast}"
        },
        "easing": {
          "$type": "cubicBezier",
          "$value": "{easing.standard}"
        }
      }
    },
    "panel": {
      "padding-inline": {
        "$type": "dimension",
        "$value": "{space.8}"
      },
      "padding-block": {
        "$type": "dimension",
        "$value": "{space.12}"
      },
      "color": {
        "$type": "color",
        "$value": "{global.text.on-base.neutral.secondary}"
      },
      "typography": {
        "$type": "typography",
        "small": {
          "$value": {
            "fontFamily": "{body.family}",
            "fontSize": "{body.size.sm}",
            "fontWeight": "{body.weight.regular}",
            "lineHeight": "{font.line-height.normal}",
            "letterSpacing": "{font.letter-spacing.normal}"
          }
        },
        "medium": {
          "$value": {
            "fontFamily": "{body.family}",
            "fontSize": "{body.size.md}",
            "fontWeight": "{body.weight.regular}",
            "lineHeight": "{font.line-height.normal}",
            "letterSpacing": "{font.letter-spacing.normal}"
          }
        }
      }
    }
  }
}
