{
  "$description": "Component tokens for Icon. Path grammar: icon.<part>.<property>[.<size>|.<color>]. Parts, options and states must exist in packages/components/specs/components/icon.spec.json. Values alias semantic tokens only (Figma library mapped colors and scales, and the additions).",
  "icon": {
    "container": {
      "font-family": {
        "$type": "fontFamily",
        "$value": "{font.icon.family}"
      },
      "font-weight": {
        "$type": "fontWeight",
        "$value": "{font.icon.weight.light}"
      },
      "fill": {
        "$type": "number",
        "$value": "{font.icon.fill.off}"
      },
      "grade": {
        "$type": "number",
        "$value": "{font.icon.grade.normal}"
      },
      "optical-size": {
        "$type": "number",
        "$value": "{font.icon.optical-size.24}"
      },
      "size": {
        "$type": "dimension",
        "small": {
          "$value": "{size.2}"
        },
        "medium": {
          "$value": "{size.3}"
        },
        "large": {
          "$value": "{size.4}"
        },
        "xlarge": {
          "$value": "{size.5}"
        },
        "xxlarge": {
          "$value": "{size.6}"
        }
      },
      "color": {
        "$type": "color",
        "$description": "The icon roles of what the icon sits on, set by the surface option: the on-base roles on a surface level (base, the default: tokens without a surface, which hold for every surface that has none of its own), the on-accent, on-subtle and on-sunken roles on a colored fill, whose hue the color option names. There is no neutral sunken fill, so neutral keeps the on-base role on sunken. The current option (the default) has no token: the glyph inherits the surrounding text color through currentColor.",
        "neutral": {
          "$value": "{global.icon.on-base.neutral.secondary}"
        },
        "brand": {
          "$value": "{global.icon.on-base.brand.default}"
        },
        "success": {
          "$value": "{global.icon.on-base.functional.success.default}"
        },
        "warning": {
          "$value": "{global.icon.on-base.functional.warning.default}"
        },
        "error": {
          "$value": "{global.icon.on-base.functional.error.default}"
        },
        "info": {
          "$value": "{global.icon.on-base.functional.info.default}"
        },
        "accent": {
          "neutral": {
            "$value": "{global.icon.on-accent.neutral.secondary}"
          },
          "brand": {
            "$value": "{global.icon.on-accent.brand.default}"
          },
          "success": {
            "$value": "{global.icon.on-accent.functional.success.default}"
          },
          "warning": {
            "$value": "{global.icon.on-accent.functional.warning.default}"
          },
          "error": {
            "$value": "{global.icon.on-accent.functional.error.default}"
          },
          "info": {
            "$value": "{global.icon.on-accent.functional.info.default}"
          }
        },
        "subtle": {
          "neutral": {
            "$value": "{global.icon.on-subtle.neutral.default}"
          },
          "brand": {
            "$value": "{global.icon.on-subtle.brand.default}"
          },
          "success": {
            "$value": "{global.icon.on-subtle.functional.success.default}"
          },
          "warning": {
            "$value": "{global.icon.on-subtle.functional.warning.default}"
          },
          "error": {
            "$value": "{global.icon.on-subtle.functional.error.default}"
          },
          "info": {
            "$value": "{global.icon.on-subtle.functional.info.default}"
          }
        },
        "sunken": {
          "brand": {
            "$value": "{global.icon.on-sunken.brand.default}"
          },
          "success": {
            "$value": "{global.icon.on-sunken.functional.success.default}"
          },
          "warning": {
            "$value": "{global.icon.on-sunken.functional.warning.default}"
          },
          "error": {
            "$value": "{global.icon.on-sunken.functional.error.default}"
          },
          "info": {
            "$value": "{global.icon.on-sunken.functional.info.default}"
          }
        }
      }
    }
  }
}
