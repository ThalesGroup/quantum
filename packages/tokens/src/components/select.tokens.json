{
  "$description": "Component tokens for Select. Path grammar: select.<part>.<property>[.<size>][.<state>]: colors vary by state only, control dimensions and type by size. Parts, options and states must exist in packages/components/specs/components/select.spec.json. Values alias semantic tokens only (Figma library mapped colors and scales, and the additions).",
  "select": {
    "container": {
      "gap": {
        "$type": "dimension",
        "$value": "{form.container.gap}",
        "$description": "Between the label, the control, the description and the message."
      }
    },
    "label": {
      "color": {
        "$type": "color",
        "default": {
          "$value": "{form.label.color.default}"
        },
        "disabled": {
          "$value": "{global.text.state.disabled.default}"
        }
      },
      "typography": {
        "$type": "typography",
        "$description": "Label text: the Forms family's label sizes per control size (form.label.font-size: body.size.sm, md, md), medium weight, the tight line height of single lines and the normal letter spacing (Forms foundation, rule anatomy, decisions forms-text-sizes and forms-token-family).",
        "small": {
          "$value": {
            "fontFamily": "{body.family}",
            "fontSize": "{form.label.font-size.small}",
            "fontWeight": "{body.weight.medium}",
            "lineHeight": "{font.line-height.tight}",
            "letterSpacing": "{font.letter-spacing.normal}"
          }
        },
        "medium": {
          "$value": {
            "fontFamily": "{body.family}",
            "fontSize": "{form.label.font-size.medium}",
            "fontWeight": "{body.weight.medium}",
            "lineHeight": "{font.line-height.tight}",
            "letterSpacing": "{font.letter-spacing.normal}"
          }
        },
        "large": {
          "$value": {
            "fontFamily": "{body.family}",
            "fontSize": "{form.label.font-size.large}",
            "fontWeight": "{body.weight.medium}",
            "lineHeight": "{font.line-height.tight}",
            "letterSpacing": "{font.letter-spacing.normal}"
          }
        }
      }
    },
    "control": {
      "$description": "The native select drawn by the component: a closed box showing the chosen option, opened by the browser.",
      "min-height": {
        "$type": "dimension",
        "small": {
          "$value": "{space.32}"
        },
        "medium": {
          "$value": "{space.40}"
        },
        "large": {
          "$value": "{space.48}"
        }
      },
      "padding-inline": {
        "$type": "dimension",
        "small": {
          "$value": "{space.8}"
        },
        "medium": {
          "$value": "{space.12}"
        },
        "large": {
          "$value": "{space.16}"
        }
      },
      "border-radius": {
        "$type": "dimension",
        "$value": "{corner-radius.xs}"
      },
      "border-width": {
        "$type": "dimension",
        "$value": "{stroke-width.sm}"
      },
      "background": {
        "$type": "color",
        "$description": "The control's fill: the Forms family's at rest and on hover; with a severity, the subtle functional fill of the severity at rest and on hover alike (Forms rule severity-fill, decision forms-severity-fill); the disabled fill wins over a severity.",
        "default": {
          "$value": "{form.control.background.default}"
        },
        "hover": {
          "$value": "{form.control.background.hover}"
        },
        "error": {
          "$value": "{form.control.background.error}"
        },
        "warning": {
          "$value": "{form.control.background.warning}"
        },
        "success": {
          "$value": "{form.control.background.success}"
        },
        "disabled": {
          "$value": "{global.bg.state.disabled.default}"
        }
      },
      "border-color": {
        "$type": "color",
        "$description": "The border at rest keeps global.border.accent.neutral.default, an override of the Forms family's default (form.control.border-color.default, the field family's base neutral border) until this control's own refinement (decision form-family-aliases).",
        "default": {
          "$value": "{global.border.accent.neutral.default}"
        },
        "error": {
          "$value": "{form.control.border-color.error}"
        },
        "warning": {
          "$value": "{form.control.border-color.warning}"
        },
        "success": {
          "$value": "{form.control.border-color.success}"
        },
        "disabled": {
          "$value": "{global.border.state.disabled.default}"
        }
      },
      "color": {
        "$type": "color",
        "default": {
          "$value": "{form.control.color.default}"
        },
        "disabled": {
          "$value": "{global.text.state.disabled.default}"
        }
      },
      "typography": {
        "$type": "typography",
        "small": {
          "$value": {
            "fontFamily": "{body.family}",
            "fontSize": "{body.size.sm}",
            "fontWeight": "{body.weight.regular}",
            "lineHeight": "{font.line-height.normal}",
            "letterSpacing": "{font.letter-spacing.normal}"
          }
        },
        "medium": {
          "$value": {
            "fontFamily": "{body.family}",
            "fontSize": "{body.size.md}",
            "fontWeight": "{body.weight.regular}",
            "lineHeight": "{font.line-height.normal}",
            "letterSpacing": "{font.letter-spacing.normal}"
          }
        },
        "large": {
          "$value": {
            "fontFamily": "{body.family}",
            "fontSize": "{body.size.lg}",
            "fontWeight": "{body.weight.regular}",
            "lineHeight": "{font.line-height.normal}",
            "letterSpacing": "{font.letter-spacing.normal}"
          }
        }
      },
      "outline-width": {
        "$type": "dimension",
        "focus-visible": {
          "$value": "{focus.ring.width}"
        }
      },
      "outline-offset": {
        "$type": "dimension",
        "focus-visible": {
          "$value": "{focus.ring.offset}"
        }
      },
      "outline-color": {
        "$type": "color",
        "focus-visible": {
          "$value": "{color.focus.ring}"
        }
      },
      "transition": {
        "duration": {
          "$type": "duration",
          "$value": "{duration.fast}"
        },
        "easing": {
          "$type": "cubicBezier",
          "$value": "{easing.standard}"
        }
      },
      "padding-inline-end": {
        "$type": "dimension",
        "$description": "Room for the chevron at the end edge, in place of the inline padding.",
        "small": {
          "$value": "{space.28}"
        },
        "medium": {
          "$value": "{space.36}"
        },
        "large": {
          "$value": "{space.40}"
        }
      }
    },
    "description": {
      "color": {
        "$type": "color",
        "default": {
          "$value": "{form.description.color.default}"
        },
        "disabled": {
          "$value": "{global.text.state.disabled.default}"
        }
      },
      "typography": {
        "$type": "typography",
        "$description": "Description text: the Forms family's description sizes per control size, smaller than the label (form.description.font-size: body.size.xs, xs, sm), regular weight, the normal line height and the normal letter spacing (Forms foundation, rule anatomy, decisions forms-text-sizes and forms-token-family).",
        "small": {
          "$value": {
            "fontFamily": "{body.family}",
            "fontSize": "{form.description.font-size.small}",
            "fontWeight": "{body.weight.regular}",
            "lineHeight": "{font.line-height.normal}",
            "letterSpacing": "{font.letter-spacing.normal}"
          }
        },
        "medium": {
          "$value": {
            "fontFamily": "{body.family}",
            "fontSize": "{form.description.font-size.medium}",
            "fontWeight": "{body.weight.regular}",
            "lineHeight": "{font.line-height.normal}",
            "letterSpacing": "{font.letter-spacing.normal}"
          }
        },
        "large": {
          "$value": {
            "fontFamily": "{body.family}",
            "fontSize": "{form.description.font-size.large}",
            "fontWeight": "{body.weight.regular}",
            "lineHeight": "{font.line-height.normal}",
            "letterSpacing": "{font.letter-spacing.normal}"
          }
        }
      }
    },
    "message": {
      "color": {
        "$type": "color",
        "error": {
          "$value": "{form.message.color.error}"
        },
        "warning": {
          "$value": "{form.message.color.warning}"
        },
        "success": {
          "$value": "{form.message.color.success}"
        }
      },
      "typography": {
        "$type": "typography",
        "$description": "Message text: the Forms family's message sizes per control size, the label's (form.message.font-size: body.size.sm, md, md), larger than the description, so the message that says what to fix reads as easily as the field; medium weight, the normal line height and the normal letter spacing (Forms foundation, rule anatomy, decisions forms-text-sizes and forms-token-family).",
        "small": {
          "$value": {
            "fontFamily": "{body.family}",
            "fontSize": "{form.message.font-size.small}",
            "fontWeight": "{body.weight.medium}",
            "lineHeight": "{font.line-height.normal}",
            "letterSpacing": "{font.letter-spacing.normal}"
          }
        },
        "medium": {
          "$value": {
            "fontFamily": "{body.family}",
            "fontSize": "{form.message.font-size.medium}",
            "fontWeight": "{body.weight.medium}",
            "lineHeight": "{font.line-height.normal}",
            "letterSpacing": "{font.letter-spacing.normal}"
          }
        },
        "large": {
          "$value": {
            "fontFamily": "{body.family}",
            "fontSize": "{form.message.font-size.large}",
            "fontWeight": "{body.weight.medium}",
            "lineHeight": "{font.line-height.normal}",
            "letterSpacing": "{font.letter-spacing.normal}"
          }
        }
      }
    },
    "indicator": {
      "$description": "Chevron glyph of the icon font drawn over the end edge of the control. Follows the control's text color through currentColor; only the font and its size are tokenized.",
      "font-family": {
        "$type": "fontFamily",
        "$value": "{font.icon.family}"
      },
      "font-weight": {
        "$type": "fontWeight",
        "$value": "{font.icon.weight.light}"
      },
      "fill": {
        "$type": "number",
        "$value": "{font.icon.fill.off}"
      },
      "grade": {
        "$type": "number",
        "$value": "{font.icon.grade.normal}"
      },
      "optical-size": {
        "$type": "number",
        "$value": "{font.icon.optical-size.24}"
      },
      "size": {
        "$type": "dimension",
        "small": {
          "$value": "{size.2}"
        },
        "medium": {
          "$value": "{size.3}"
        },
        "large": {
          "$value": "{size.4}"
        }
      },
      "margin-inline": {
        "$type": "dimension",
        "$value": "{space.8}",
        "$description": "Distance between the chevron and the end edge of the control."
      }
    },
    "severity-icon": {
      "$description": "The severity icon, a glyph of the icon font, after the control or at the start of the message (severityIcon; Forms decisions forms-severity-icon-placement, -size, -color). Only the font, the sizes, the gaps and the color are tokenized.",
      "font-family": {
        "$type": "fontFamily",
        "$value": "{font.icon.family}"
      },
      "font-weight": {
        "$type": "fontWeight",
        "$value": "{font.icon.weight.light}"
      },
      "fill": {
        "$type": "number",
        "$value": "{font.icon.fill.off}"
      },
      "grade": {
        "$type": "number",
        "$value": "{font.icon.grade.normal}"
      },
      "optical-size": {
        "$type": "number",
        "$value": "{font.icon.optical-size.24}"
      },
      "size": {
        "$type": "dimension",
        "after-control": {
          "$description": "After the control: the size of the Button's icon at the same size (button.icon.size.small, medium, large: 20, 24, 24 px).",
          "small": {
            "$value": "{size.3}"
          },
          "medium": {
            "$value": "{size.4}"
          },
          "large": {
            "$value": "{size.4}"
          }
        },
        "message": {
          "$description": "At the start of the message: the Icon's size next to 14 and 16 px body text (16 px).",
          "$value": "{size.2}"
        }
      },
      "gap": {
        "$type": "dimension",
        "after-control": {
          "$description": "Between the control and the icon.",
          "$value": "{space.8}"
        },
        "message": {
          "$description": "Between the icon and the message text.",
          "$value": "{space.4}"
        }
      },
      "color": {
        "$type": "color",
        "$description": "The on-base icon role of the severity: the icon sits on the surface, beside the control or in the message, and takes the message text's color.",
        "error": {
          "$value": "{form.severity-icon.color.error}"
        },
        "warning": {
          "$value": "{form.severity-icon.color.warning}"
        },
        "success": {
          "$value": "{form.severity-icon.color.success}"
        }
      }
    },
    "mark": {
      "$description": "The required mark, \"(optional)\" or \"(required)\" at the end of the label (markedFields; decision mark-style).",
      "color": {
        "$type": "color",
        "default": {
          "$value": "{form.mark.color.default}"
        },
        "disabled": {
          "$value": "{global.text.state.disabled.default}"
        }
      },
      "typography": {
        "$type": "typography",
        "$description": "The label's typography in the regular weight: the mark is the label's size, regular (Forms decision forms-mark-style).",
        "small": {
          "$value": {
            "fontFamily": "{body.family}",
            "fontSize": "{form.label.font-size.small}",
            "fontWeight": "{body.weight.regular}",
            "lineHeight": "{font.line-height.tight}",
            "letterSpacing": "{font.letter-spacing.normal}"
          }
        },
        "medium": {
          "$value": {
            "fontFamily": "{body.family}",
            "fontSize": "{form.label.font-size.medium}",
            "fontWeight": "{body.weight.regular}",
            "lineHeight": "{font.line-height.tight}",
            "letterSpacing": "{font.letter-spacing.normal}"
          }
        },
        "large": {
          "$value": {
            "fontFamily": "{body.family}",
            "fontSize": "{form.label.font-size.large}",
            "fontWeight": "{body.weight.regular}",
            "lineHeight": "{font.line-height.tight}",
            "letterSpacing": "{font.letter-spacing.normal}"
          }
        }
      }
    },
    "asterisk": {
      "$description": "Android and Windows only: the asterisk of a required field, in place of the mark (Forms decision forms-asterisk-style). It takes the label's typography (label.typography.*). Neither the web reference rendering nor the Figma component draws it.",
      "color": {
        "$type": "color",
        "default": {
          "$description": "The error message's and the error icon's red.",
          "$value": "{form.asterisk.color.default}"
        },
        "disabled": {
          "$value": "{global.text.state.disabled.default}"
        }
      },
      "margin-inline-start": {
        "$type": "dimension",
        "$description": "Between the label and the asterisk, with no word space.",
        "small": {
          "$value": "{space.2}"
        },
        "medium": {
          "$value": "{space.4}"
        },
        "large": {
          "$value": "{space.4}"
        }
      }
    }
  }
}
