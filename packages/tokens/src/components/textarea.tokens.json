{
  "$description": "Component tokens for Textarea. Path grammar: textarea.<part>.<property>[.<size>][.<state>]: colors vary by state only, control dimensions and type by size. Parts, options and states must exist in packages/components/specs/components/textarea.spec.json. Values alias semantic tokens only (Figma library mapped colors and scales, and the additions).",
  "textarea": {
    "container": {
      "gap": {
        "$type": "dimension",
        "$value": "{space.6}",
        "$description": "Between the label, the control, the description and the message: one value at every size and state, so the box never moves."
      }
    },
    "label": {
      "color": {
        "$type": "color",
        "default": {
          "$value": "{global.text.on-base.neutral.primary}"
        },
        "disabled": {
          "$value": "{global.text.state.disabled.default}"
        }
      },
      "typography": {
        "$type": "typography",
        "$description": "Label text: scales with the field, the text size of the value and of the Button of the same size (body.size.sm, md, md), medium weight, the tight line height of single lines and the normal letter spacing (Typography foundation).",
        "small": {
          "$value": {
            "fontFamily": "{body.family}",
            "fontSize": "{body.size.sm}",
            "fontWeight": "{body.weight.medium}",
            "lineHeight": "{font.line-height.tight}",
            "letterSpacing": "{font.letter-spacing.normal}"
          }
        },
        "medium": {
          "$value": {
            "fontFamily": "{body.family}",
            "fontSize": "{body.size.md}",
            "fontWeight": "{body.weight.medium}",
            "lineHeight": "{font.line-height.tight}",
            "letterSpacing": "{font.letter-spacing.normal}"
          }
        },
        "large": {
          "$value": {
            "fontFamily": "{body.family}",
            "fontSize": "{body.size.md}",
            "fontWeight": "{body.weight.medium}",
            "lineHeight": "{font.line-height.tight}",
            "letterSpacing": "{font.letter-spacing.normal}"
          }
        }
      }
    },
    "control": {
      "$description": "The editable box: a native multi-line text control drawn by the component. Its height follows the rows property; min-height is the height of a single row.",
      "min-height": {
        "$type": "dimension",
        "$description": "Height of the box: the height of the Button of the same size (space.28, 36, 44).",
        "small": {
          "$value": "{space.28}"
        },
        "medium": {
          "$value": "{space.36}"
        },
        "large": {
          "$value": "{space.44}"
        }
      },
      "padding-inline": {
        "$type": "dimension",
        "small": {
          "$value": "{space.8}"
        },
        "medium": {
          "$value": "{space.12}"
        },
        "large": {
          "$value": "{space.16}"
        }
      },
      "border-radius": {
        "$type": "dimension",
        "$description": "The Button's corner radius at the same size (Shape foundation): 2 px at small, 4 px at medium and large.",
        "small": {
          "$value": "{corner-radius.2xs}"
        },
        "medium": {
          "$value": "{corner-radius.xs}"
        },
        "large": {
          "$value": "{corner-radius.xs}"
        }
      },
      "border-width": {
        "$type": "dimension",
        "$value": "{stroke-width.sm}"
      },
      "background": {
        "$type": "color",
        "default": {
          "$value": "{global.bg.level.0.default}"
        },
        "hover": {
          "$value": "{global.bg.level.0.hover}"
        },
        "error": {
          "$value": "{global.bg.subtle.functional.error.default}",
          "$description": "The fill of a control in error, at rest and on hover alike: the subtle error background (Forms foundation, decision forms-severity-fill). Its hover step would bring the placeholder under 4.5:1 in light mode."
        },
        "warning": {
          "$value": "{global.bg.subtle.functional.warning.default}",
          "$description": "The fill of a control with a warning, at rest and on hover alike: the subtle warning background (Forms foundation, decision forms-severity-fill), as in error."
        },
        "success": {
          "$value": "{global.bg.subtle.functional.success.default}",
          "$description": "The fill of a control with a success, at rest and on hover alike: the subtle success background (Forms foundation, decision forms-severity-fill), as in error."
        },
        "readonly": {
          "$value": "{global.bg.level.1.default}"
        },
        "disabled": {
          "$value": "{global.bg.state.disabled.default}"
        }
      },
      "border-color": {
        "$type": "color",
        "default": {
          "$value": "{global.border.base.neutral.5}"
        },
        "error": {
          "$value": "{global.border.accent.functional.error.default}"
        },
        "warning": {
          "$value": "{global.border.accent.functional.warning.default}"
        },
        "success": {
          "$value": "{global.border.accent.functional.success.default}"
        },
        "disabled": {
          "$value": "{global.border.state.disabled.default}"
        }
      },
      "color": {
        "$type": "color",
        "default": {
          "$value": "{global.text.on-base.neutral.primary}"
        },
        "disabled": {
          "$value": "{global.text.state.disabled.default}"
        }
      },
      "placeholder-color": {
        "$type": "color",
        "$description": "Color of the placeholder hint, lighter than the value.",
        "default": {
          "$value": "{global.text.on-base.neutral.tertiary}"
        },
        "disabled": {
          "$value": "{global.text.state.disabled.default}"
        }
      },
      "typography": {
        "$type": "typography",
        "$description": "Value and placeholder text: the text size of the Button of the same size (body.size.sm, md, md), regular weight, the tight line height of single lines and the normal letter spacing (Typography foundation).",
        "small": {
          "$value": {
            "fontFamily": "{body.family}",
            "fontSize": "{body.size.sm}",
            "fontWeight": "{body.weight.regular}",
            "lineHeight": "{font.line-height.tight}",
            "letterSpacing": "{font.letter-spacing.normal}"
          }
        },
        "medium": {
          "$value": {
            "fontFamily": "{body.family}",
            "fontSize": "{body.size.md}",
            "fontWeight": "{body.weight.regular}",
            "lineHeight": "{font.line-height.tight}",
            "letterSpacing": "{font.letter-spacing.normal}"
          }
        },
        "large": {
          "$value": {
            "fontFamily": "{body.family}",
            "fontSize": "{body.size.md}",
            "fontWeight": "{body.weight.regular}",
            "lineHeight": "{font.line-height.tight}",
            "letterSpacing": "{font.letter-spacing.normal}"
          }
        }
      },
      "outline-width": {
        "$type": "dimension",
        "focus-visible": {
          "$value": "{focus.ring.width}"
        },
        "error": {
          "$value": "{stroke-width.md}"
        },
        "warning": {
          "$value": "{stroke-width.md}"
        },
        "success": {
          "$value": "{stroke-width.md}"
        }
      },
      "outline-color": {
        "$type": "color",
        "focus-visible": {
          "$value": "{color.focus.ring}"
        },
        "error": {
          "$value": "{global.border.accent.functional.error.default}"
        },
        "warning": {
          "$value": "{global.border.accent.functional.warning.default}"
        },
        "success": {
          "$value": "{global.border.accent.functional.success.default}"
        }
      },
      "transition": {
        "duration": {
          "$type": "duration",
          "$value": "{duration.fast}"
        },
        "easing": {
          "$type": "cubicBezier",
          "$value": "{easing.standard}"
        }
      },
      "padding-block": {
        "$type": "dimension",
        "small": {
          "$value": "{space.6}"
        },
        "medium": {
          "$value": "{space.8}"
        },
        "large": {
          "$value": "{space.12}"
        }
      }
    },
    "description": {
      "color": {
        "$type": "color",
        "default": {
          "$value": "{global.text.on-base.neutral.secondary}"
        },
        "disabled": {
          "$value": "{global.text.state.disabled.default}"
        }
      },
      "typography": {
        "$type": "typography",
        "$description": "Description text: the helper size, smaller than the label and the value (body.size.xs, xs, sm), regular weight, the normal line height and the normal letter spacing (Typography foundation).",
        "small": {
          "$value": {
            "fontFamily": "{body.family}",
            "fontSize": "{body.size.xs}",
            "fontWeight": "{body.weight.regular}",
            "lineHeight": "{font.line-height.normal}",
            "letterSpacing": "{font.letter-spacing.normal}"
          }
        },
        "medium": {
          "$value": {
            "fontFamily": "{body.family}",
            "fontSize": "{body.size.xs}",
            "fontWeight": "{body.weight.regular}",
            "lineHeight": "{font.line-height.normal}",
            "letterSpacing": "{font.letter-spacing.normal}"
          }
        },
        "large": {
          "$value": {
            "fontFamily": "{body.family}",
            "fontSize": "{body.size.sm}",
            "fontWeight": "{body.weight.regular}",
            "lineHeight": "{font.line-height.normal}",
            "letterSpacing": "{font.letter-spacing.normal}"
          }
        }
      }
    },
    "severity-icon": {
      "$description": "The severity icon, a glyph of the icon font, after the control or at the start of the message (severityIcon; Forms decisions forms-severity-icon-placement, -size, -color). Only the font, the sizes, the gaps and the color are tokenized.",
      "font-family": {
        "$type": "fontFamily",
        "$value": "{font.icon.family}"
      },
      "font-weight": {
        "$type": "fontWeight",
        "$value": "{font.icon.weight.light}"
      },
      "fill": {
        "$type": "number",
        "$value": "{font.icon.fill.off}"
      },
      "grade": {
        "$type": "number",
        "$value": "{font.icon.grade.normal}"
      },
      "optical-size": {
        "$type": "number",
        "$value": "{font.icon.optical-size.24}"
      },
      "size": {
        "$type": "dimension",
        "after-control": {
          "$description": "After the control: the size of the Button's icon at the same size (button.icon.size.small, medium, large: 20, 24, 24 px).",
          "small": {
            "$value": "{size.3}"
          },
          "medium": {
            "$value": "{size.4}"
          },
          "large": {
            "$value": "{size.4}"
          }
        },
        "message": {
          "$description": "At the start of the message: the Icon's size next to 14 and 16 px body text (16 px).",
          "$value": "{size.2}"
        }
      },
      "gap": {
        "$type": "dimension",
        "after-control": {
          "$description": "Between the control and the icon.",
          "$value": "{space.8}"
        },
        "message": {
          "$description": "Between the icon and the message text.",
          "$value": "{space.4}"
        }
      },
      "color": {
        "$type": "color",
        "$description": "The on-base icon role of the severity: the icon sits on the surface, beside the control or in the message, and takes the message text's color.",
        "error": {
          "$value": "{global.icon.on-base.functional.error.default}"
        },
        "warning": {
          "$value": "{global.icon.on-base.functional.warning.default}"
        },
        "success": {
          "$value": "{global.icon.on-base.functional.success.default}"
        }
      }
    },
    "message": {
      "color": {
        "$type": "color",
        "error": {
          "$value": "{global.text.on-base.functional.error.default}"
        },
        "warning": {
          "$value": "{global.text.on-base.functional.warning.default}"
        },
        "success": {
          "$value": "{global.text.on-base.functional.success.default}"
        }
      },
      "typography": {
        "$type": "typography",
        "$description": "Message text: the label's and the value's size (body.size.sm, md, md), larger than the description, so the message that says what to fix reads as easily as the field itself; medium weight, the normal line height and the normal letter spacing (Typography foundation).",
        "small": {
          "$value": {
            "fontFamily": "{body.family}",
            "fontSize": "{body.size.sm}",
            "fontWeight": "{body.weight.medium}",
            "lineHeight": "{font.line-height.normal}",
            "letterSpacing": "{font.letter-spacing.normal}"
          }
        },
        "medium": {
          "$value": {
            "fontFamily": "{body.family}",
            "fontSize": "{body.size.md}",
            "fontWeight": "{body.weight.medium}",
            "lineHeight": "{font.line-height.normal}",
            "letterSpacing": "{font.letter-spacing.normal}"
          }
        },
        "large": {
          "$value": {
            "fontFamily": "{body.family}",
            "fontSize": "{body.size.md}",
            "fontWeight": "{body.weight.medium}",
            "lineHeight": "{font.line-height.normal}",
            "letterSpacing": "{font.letter-spacing.normal}"
          }
        }
      }
    }
  }
}
