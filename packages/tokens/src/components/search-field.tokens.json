{
  "$description": "Component tokens for Search field. Path grammar: search-field.<part>.<property>[.<size>][.<state>]: colors vary by state only, control dimensions and type by size. Parts, options and states must exist in packages/components/specs/components/search-field.spec.json. Values alias semantic tokens only (Figma library mapped colors and scales, and the additions).",
  "search-field": {
    "container": {
      "gap": {
        "$type": "dimension",
        "$value": "{space.6}",
        "$description": "Between the label, the control, the description and the message: one value at every size and state, so the box never moves."
      }
    },
    "label": {
      "color": {
        "$type": "color",
        "default": {
          "$value": "{global.text.on-base.neutral.primary}"
        },
        "disabled": {
          "$value": "{global.text.state.disabled.default}"
        }
      },
      "typography": {
        "$type": "typography",
        "$description": "Label text: scales with the field, the text size of the value and of the Button of the same size (body.size.sm, md, md), medium weight, the tight line height of single lines and the normal letter spacing (Typography foundation).",
        "small": {
          "$value": {
            "fontFamily": "{body.family}",
            "fontSize": "{body.size.sm}",
            "fontWeight": "{body.weight.medium}",
            "lineHeight": "{font.line-height.tight}",
            "letterSpacing": "{font.letter-spacing.normal}"
          }
        },
        "medium": {
          "$value": {
            "fontFamily": "{body.family}",
            "fontSize": "{body.size.md}",
            "fontWeight": "{body.weight.medium}",
            "lineHeight": "{font.line-height.tight}",
            "letterSpacing": "{font.letter-spacing.normal}"
          }
        },
        "large": {
          "$value": {
            "fontFamily": "{body.family}",
            "fontSize": "{body.size.md}",
            "fontWeight": "{body.weight.medium}",
            "lineHeight": "{font.line-height.tight}",
            "letterSpacing": "{font.letter-spacing.normal}"
          }
        }
      }
    },
    "mark": {
      "$description": "The required mark, \"(optional)\" or \"(required)\" at the end of the label (markedFields; decision mark-style).",
      "color": {
        "$type": "color",
        "default": {
          "$value": "{global.text.on-base.neutral.secondary}"
        },
        "disabled": {
          "$value": "{global.text.state.disabled.default}"
        }
      },
      "typography": {
        "$type": "typography",
        "$description": "The label's size (body.size.sm, md, md), the regular weight, the label's line height and letter spacing.",
        "small": {
          "$value": {
            "fontFamily": "{body.family}",
            "fontSize": "{body.size.sm}",
            "fontWeight": "{body.weight.regular}",
            "lineHeight": "{font.line-height.tight}",
            "letterSpacing": "{font.letter-spacing.normal}"
          }
        },
        "medium": {
          "$value": {
            "fontFamily": "{body.family}",
            "fontSize": "{body.size.md}",
            "fontWeight": "{body.weight.regular}",
            "lineHeight": "{font.line-height.tight}",
            "letterSpacing": "{font.letter-spacing.normal}"
          }
        },
        "large": {
          "$value": {
            "fontFamily": "{body.family}",
            "fontSize": "{body.size.md}",
            "fontWeight": "{body.weight.regular}",
            "lineHeight": "{font.line-height.tight}",
            "letterSpacing": "{font.letter-spacing.normal}"
          }
        }
      }
    },
    "asterisk": {
      "$description": "Android and Windows only: the asterisk of a required field, in place of the mark (decision asterisk-style). It takes the label's typography (label.typography.*). Neither the web reference rendering nor the Figma component draws it.",
      "color": {
        "$type": "color",
        "default": {
          "$description": "The error message's and the error icon's red.",
          "$value": "{global.text.on-base.functional.error.default}"
        },
        "disabled": {
          "$value": "{global.text.state.disabled.default}"
        }
      },
      "margin-inline-start": {
        "$type": "dimension",
        "$description": "Between the label and the asterisk, with no word space.",
        "small": {
          "$value": "{space.2}"
        },
        "medium": {
          "$value": "{space.4}"
        },
        "large": {
          "$value": "{space.4}"
        }
      }
    },
    "control": {
      "$description": "The editable box: the native search input, drawn by the component, with the search glyph drawn over its start edge.",
      "min-height": {
        "$type": "dimension",
        "$description": "Height of the box: the height of the Button of the same size (space.28, 36, 44).",
        "small": {
          "$value": "{space.28}"
        },
        "medium": {
          "$value": "{space.36}"
        },
        "large": {
          "$value": "{space.44}"
        }
      },
      "padding-inline": {
        "$type": "dimension",
        "small": {
          "$value": "{space.8}"
        },
        "medium": {
          "$value": "{space.12}"
        },
        "large": {
          "$value": "{space.16}"
        }
      },
      "border-radius": {
        "$type": "dimension",
        "$description": "The Button's corner radius at the same size (Shape foundation): 2 px at small, 4 px at medium and large.",
        "small": {
          "$value": "{corner-radius.2xs}"
        },
        "medium": {
          "$value": "{corner-radius.xs}"
        },
        "large": {
          "$value": "{corner-radius.xs}"
        }
      },
      "border-width": {
        "$type": "dimension",
        "$value": "{stroke-width.sm}"
      },
      "background": {
        "$type": "color",
        "default": {
          "$value": "{global.bg.level.0.default}"
        },
        "hover": {
          "$value": "{global.bg.level.0.hover}"
        },
        "disabled": {
          "$value": "{global.bg.state.disabled.default}"
        }
      },
      "border-color": {
        "$type": "color",
        "default": {
          "$value": "{global.border.base.neutral.5}"
        },
        "disabled": {
          "$value": "{global.border.state.disabled.default}"
        }
      },
      "color": {
        "$type": "color",
        "default": {
          "$value": "{global.text.on-base.neutral.primary}"
        },
        "disabled": {
          "$value": "{global.text.state.disabled.default}"
        }
      },
      "placeholder-color": {
        "$type": "color",
        "$description": "Color of the placeholder hint, lighter than the value.",
        "default": {
          "$value": "{global.text.on-base.neutral.tertiary}"
        },
        "disabled": {
          "$value": "{global.text.state.disabled.default}"
        }
      },
      "typography": {
        "$type": "typography",
        "$description": "Value and placeholder text: the text size of the Button of the same size (body.size.sm, md, md), regular weight, the tight line height of single lines and the normal letter spacing (Typography foundation).",
        "small": {
          "$value": {
            "fontFamily": "{body.family}",
            "fontSize": "{body.size.sm}",
            "fontWeight": "{body.weight.regular}",
            "lineHeight": "{font.line-height.tight}",
            "letterSpacing": "{font.letter-spacing.normal}"
          }
        },
        "medium": {
          "$value": {
            "fontFamily": "{body.family}",
            "fontSize": "{body.size.md}",
            "fontWeight": "{body.weight.regular}",
            "lineHeight": "{font.line-height.tight}",
            "letterSpacing": "{font.letter-spacing.normal}"
          }
        },
        "large": {
          "$value": {
            "fontFamily": "{body.family}",
            "fontSize": "{body.size.md}",
            "fontWeight": "{body.weight.regular}",
            "lineHeight": "{font.line-height.tight}",
            "letterSpacing": "{font.letter-spacing.normal}"
          }
        }
      },
      "outline-width": {
        "$type": "dimension",
        "focus-visible": {
          "$value": "{focus.ring.width}"
        }
      },
      "outline-color": {
        "$type": "color",
        "focus-visible": {
          "$value": "{color.focus.ring}"
        }
      },
      "transition": {
        "duration": {
          "$type": "duration",
          "$value": "{duration.fast}"
        },
        "easing": {
          "$type": "cubicBezier",
          "$value": "{easing.standard}"
        }
      },
      "padding-inline-start": {
        "$type": "dimension",
        "$description": "Room for the search glyph at the start edge, in place of the inline padding; icon.margin-inline + icon.size + the gap to the text, the leading icon's of the Text field (decision leading-icon-spacing).",
        "small": {
          "$value": "{space.28}"
        },
        "medium": {
          "$value": "{space.36}"
        },
        "large": {
          "$value": "{space.40}"
        }
      }
    },
    "description": {
      "color": {
        "$type": "color",
        "default": {
          "$value": "{global.text.on-base.neutral.secondary}"
        },
        "disabled": {
          "$value": "{global.text.state.disabled.default}"
        }
      },
      "typography": {
        "$type": "typography",
        "$description": "Description text: the helper size, smaller than the label and the value (body.size.xs, xs, sm), regular weight, the normal line height and the normal letter spacing (Typography foundation).",
        "small": {
          "$value": {
            "fontFamily": "{body.family}",
            "fontSize": "{body.size.xs}",
            "fontWeight": "{body.weight.regular}",
            "lineHeight": "{font.line-height.normal}",
            "letterSpacing": "{font.letter-spacing.normal}"
          }
        },
        "medium": {
          "$value": {
            "fontFamily": "{body.family}",
            "fontSize": "{body.size.xs}",
            "fontWeight": "{body.weight.regular}",
            "lineHeight": "{font.line-height.normal}",
            "letterSpacing": "{font.letter-spacing.normal}"
          }
        },
        "large": {
          "$value": {
            "fontFamily": "{body.family}",
            "fontSize": "{body.size.sm}",
            "fontWeight": "{body.weight.regular}",
            "lineHeight": "{font.line-height.normal}",
            "letterSpacing": "{font.letter-spacing.normal}"
          }
        }
      }
    },
    "icon": {
      "$description": "Search glyph of the icon font over the start edge of the control. Follows the text beside it: the placeholder's color while the field is empty, the value's once something is typed (decision leading-icon-color).",
      "font-family": {
        "$type": "fontFamily",
        "$value": "{font.icon.family}"
      },
      "font-weight": {
        "$type": "fontWeight",
        "$value": "{font.icon.weight.light}"
      },
      "fill": {
        "$type": "number",
        "$value": "{font.icon.fill.off}"
      },
      "grade": {
        "$type": "number",
        "$value": "{font.icon.grade.normal}"
      },
      "optical-size": {
        "$type": "number",
        "$value": "{font.icon.optical-size.24}"
      },
      "size": {
        "$type": "dimension",
        "small": {
          "$value": "{size.2}"
        },
        "medium": {
          "$value": "{size.3}"
        },
        "large": {
          "$value": "{size.4}"
        }
      },
      "margin-inline": {
        "$type": "dimension",
        "$value": "{space.8}"
      },
      "color": {
        "$type": "color",
        "$description": "Color of the glyph beside a typed value: the value's role (decision leading-icon-color).",
        "default": {
          "$value": "{global.icon.on-base.neutral.primary}"
        },
        "disabled": {
          "$value": "{global.icon.state.disabled.default}"
        }
      },
      "placeholder-color": {
        "$type": "color",
        "$description": "Color of the glyph while the field is empty: the placeholder's role (decision leading-icon-color).",
        "default": {
          "$value": "{global.icon.on-base.neutral.tertiary}"
        },
        "disabled": {
          "$value": "{global.icon.state.disabled.default}"
        }
      }
    }
  }
}
