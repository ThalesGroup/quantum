{
  "$description": "Component tokens for Search field. Path grammar: search-field.<part>.<property>[.<size>][.<state>]: colors vary by state only, control dimensions and type by size. Parts, options and states must exist in packages/components/specs/components/search-field.spec.json. Values alias semantic tokens only (Figma library mapped colors and scales, and the additions).",
  "search-field": {
    "container": {
      "gap": {
        "$type": "dimension",
        "$value": "{space.6}",
        "$description": "Between the label, the control, the description and the message: one value at every size and state, so the box never moves."
      }
    },
    "label": {
      "color": {
        "$type": "color",
        "default": {
          "$value": "{global.text.on-base.neutral.primary}"
        },
        "disabled": {
          "$value": "{global.text.state.disabled.default}"
        }
      },
      "typography": {
        "$type": "typography",
        "$description": "Label text: scales with the field, the text size of the value and of the Button of the same size (body.size.sm, md, md), medium weight, the tight line height of single lines and the normal letter spacing (Typography foundation).",
        "small": {
          "$value": {
            "fontFamily": "{body.family}",
            "fontSize": "{body.size.sm}",
            "fontWeight": "{body.weight.medium}",
            "lineHeight": "{font.line-height.tight}",
            "letterSpacing": "{font.letter-spacing.normal}"
          }
        },
        "medium": {
          "$value": {
            "fontFamily": "{body.family}",
            "fontSize": "{body.size.md}",
            "fontWeight": "{body.weight.medium}",
            "lineHeight": "{font.line-height.tight}",
            "letterSpacing": "{font.letter-spacing.normal}"
          }
        },
        "large": {
          "$value": {
            "fontFamily": "{body.family}",
            "fontSize": "{body.size.md}",
            "fontWeight": "{body.weight.medium}",
            "lineHeight": "{font.line-height.tight}",
            "letterSpacing": "{font.letter-spacing.normal}"
          }
        }
      }
    },
    "mark": {
      "$description": "The required mark, \"(optional)\" or \"(required)\" at the end of the label (markedFields; decision mark-style).",
      "color": {
        "$type": "color",
        "default": {
          "$value": "{global.text.on-base.neutral.secondary}"
        },
        "disabled": {
          "$value": "{global.text.state.disabled.default}"
        }
      },
      "typography": {
        "$type": "typography",
        "$description": "The label's size (body.size.sm, md, md), the regular weight, the label's line height and letter spacing.",
        "small": {
          "$value": {
            "fontFamily": "{body.family}",
            "fontSize": "{body.size.sm}",
            "fontWeight": "{body.weight.regular}",
            "lineHeight": "{font.line-height.tight}",
            "letterSpacing": "{font.letter-spacing.normal}"
          }
        },
        "medium": {
          "$value": {
            "fontFamily": "{body.family}",
            "fontSize": "{body.size.md}",
            "fontWeight": "{body.weight.regular}",
            "lineHeight": "{font.line-height.tight}",
            "letterSpacing": "{font.letter-spacing.normal}"
          }
        },
        "large": {
          "$value": {
            "fontFamily": "{body.family}",
            "fontSize": "{body.size.md}",
            "fontWeight": "{body.weight.regular}",
            "lineHeight": "{font.line-height.tight}",
            "letterSpacing": "{font.letter-spacing.normal}"
          }
        }
      }
    },
    "asterisk": {
      "$description": "Android and Windows only: the asterisk of a required field, in place of the mark (decision asterisk-style). It takes the label's typography (label.typography.*). Neither the web reference rendering nor the Figma component draws it.",
      "color": {
        "$type": "color",
        "default": {
          "$description": "The error message's and the error icon's red.",
          "$value": "{global.text.on-base.functional.error.default}"
        },
        "disabled": {
          "$value": "{global.text.state.disabled.default}"
        }
      },
      "margin-inline-start": {
        "$type": "dimension",
        "$description": "Between the label and the asterisk, with no word space.",
        "small": {
          "$value": "{space.2}"
        },
        "medium": {
          "$value": "{space.4}"
        },
        "large": {
          "$value": "{space.4}"
        }
      }
    },
    "control": {
      "$description": "The editable box: the native search input, drawn by the component, with the search glyph drawn over its start edge.",
      "min-height": {
        "$type": "dimension",
        "$description": "Height of the box: the height of the Button of the same size (space.28, 36, 44).",
        "small": {
          "$value": "{space.28}"
        },
        "medium": {
          "$value": "{space.36}"
        },
        "large": {
          "$value": "{space.44}"
        }
      },
      "padding-block": {
        "$type": "dimension",
        "$description": "Minimum space above and below the value's line, the Button's (space.3, 5, 8). At the default text size the minimum height sets the height; this padding shows when the text outgrows it (decision grows-with-text-size).",
        "small": {
          "$value": "{space.3}"
        },
        "medium": {
          "$value": "{space.5}"
        },
        "large": {
          "$value": "{space.8}"
        }
      },
      "line-height": {
        "$type": "number",
        "$description": "Shortest line of the value on the web, as a multiple of its text size: the input takes its block padding into its line, never shorter than this, because Chromium and WebKit clip an input's text to its line box and the stacked marks of Ấ, Ỗ, Ẫ reach past a 1.2 line (decision value-line-not-clipped). The value's text style keeps control.typography (1.2).",
        "$value": "{font.line-height.normal}"
      },
      "padding-inline": {
        "$type": "dimension",
        "small": {
          "$value": "{space.8}"
        },
        "medium": {
          "$value": "{space.12}"
        },
        "large": {
          "$value": "{space.16}"
        }
      },
      "border-radius": {
        "$type": "dimension",
        "$description": "The Button's corner radius at the same size (Shape foundation): 2 px at small, 4 px at medium and large.",
        "small": {
          "$value": "{corner-radius.2xs}"
        },
        "medium": {
          "$value": "{corner-radius.xs}"
        },
        "large": {
          "$value": "{corner-radius.xs}"
        }
      },
      "border-width": {
        "$type": "dimension",
        "$value": "{stroke-width.sm}"
      },
      "background": {
        "$type": "color",
        "default": {
          "$value": "{global.bg.level.0.default}"
        },
        "hover": {
          "$value": "{global.bg.level.0.hover}"
        },
        "error": {
          "$value": "{global.bg.subtle.functional.error.default}",
          "$description": "The fill of a control in error, at rest and on hover alike: the subtle error background (Forms foundation, decision forms-severity-fill). Its hover step would bring the placeholder under 4.5:1 in light mode."
        },
        "warning": {
          "$value": "{global.bg.subtle.functional.warning.default}",
          "$description": "The fill of a control with a warning, at rest and on hover alike: the subtle warning background (Forms foundation, decision forms-severity-fill), as in error."
        },
        "success": {
          "$value": "{global.bg.subtle.functional.success.default}",
          "$description": "The fill of a control with a success, at rest and on hover alike: the subtle success background (Forms foundation, decision forms-severity-fill), as in error."
        },
        "disabled": {
          "$value": "{global.bg.state.disabled.default}"
        }
      },
      "border-color": {
        "$type": "color",
        "default": {
          "$value": "{global.border.base.neutral.5}"
        },
        "error": {
          "$value": "{global.border.accent.functional.error.default}"
        },
        "warning": {
          "$value": "{global.border.accent.functional.warning.default}"
        },
        "success": {
          "$value": "{global.border.accent.functional.success.default}"
        },
        "disabled": {
          "$value": "{global.border.state.disabled.default}"
        }
      },
      "color": {
        "$type": "color",
        "default": {
          "$value": "{global.text.on-base.neutral.primary}"
        },
        "disabled": {
          "$value": "{global.text.state.disabled.default}"
        }
      },
      "placeholder-color": {
        "$type": "color",
        "$description": "Color of the placeholder hint, lighter than the value.",
        "default": {
          "$value": "{global.text.on-base.neutral.tertiary}"
        },
        "disabled": {
          "$value": "{global.text.state.disabled.default}"
        }
      },
      "typography": {
        "$type": "typography",
        "$description": "Value and placeholder text: the text size of the Button of the same size (body.size.sm, md, md), regular weight, the tight line height of single lines and the normal letter spacing (Typography foundation).",
        "small": {
          "$value": {
            "fontFamily": "{body.family}",
            "fontSize": "{body.size.sm}",
            "fontWeight": "{body.weight.regular}",
            "lineHeight": "{font.line-height.tight}",
            "letterSpacing": "{font.letter-spacing.normal}"
          }
        },
        "medium": {
          "$value": {
            "fontFamily": "{body.family}",
            "fontSize": "{body.size.md}",
            "fontWeight": "{body.weight.regular}",
            "lineHeight": "{font.line-height.tight}",
            "letterSpacing": "{font.letter-spacing.normal}"
          }
        },
        "large": {
          "$value": {
            "fontFamily": "{body.family}",
            "fontSize": "{body.size.md}",
            "fontWeight": "{body.weight.regular}",
            "lineHeight": "{font.line-height.tight}",
            "letterSpacing": "{font.letter-spacing.normal}"
          }
        }
      },
      "outline-width": {
        "$type": "dimension",
        "focus-visible": {
          "$value": "{focus.ring.width}"
        },
        "error": {
          "$value": "{stroke-width.md}"
        },
        "warning": {
          "$value": "{stroke-width.md}"
        },
        "success": {
          "$value": "{stroke-width.md}"
        }
      },
      "outline-color": {
        "$type": "color",
        "focus-visible": {
          "$value": "{color.focus.ring}"
        },
        "error": {
          "$value": "{global.border.accent.functional.error.default}"
        },
        "warning": {
          "$value": "{global.border.accent.functional.warning.default}"
        },
        "success": {
          "$value": "{global.border.accent.functional.success.default}"
        }
      },
      "transition": {
        "duration": {
          "$type": "duration",
          "$value": "{duration.fast}"
        },
        "easing": {
          "$type": "cubicBezier",
          "$value": "{easing.standard}"
        }
      },
      "padding-inline-start": {
        "$type": "dimension",
        "$description": "Room for the search glyph at the start edge, in place of the inline padding; icon.margin-inline + icon.size + the gap to the text, the leading icon's of the Text field (decision leading-icon-spacing).",
        "small": {
          "$value": "{space.28}"
        },
        "medium": {
          "$value": "{space.36}"
        },
        "large": {
          "$value": "{space.40}"
        }
      }
    },
    "icon": {
      "$description": "Search glyph of the icon font over the start edge of the control. Follows the text beside it: the placeholder's color while the field is empty, the value's once something is typed (decision leading-icon-color).",
      "font-family": {
        "$type": "fontFamily",
        "$value": "{font.icon.family}"
      },
      "font-weight": {
        "$type": "fontWeight",
        "$value": "{font.icon.weight.light}"
      },
      "fill": {
        "$type": "number",
        "$value": "{font.icon.fill.off}"
      },
      "grade": {
        "$type": "number",
        "$value": "{font.icon.grade.normal}"
      },
      "optical-size": {
        "$type": "number",
        "$value": "{font.icon.optical-size.24}"
      },
      "size": {
        "$type": "dimension",
        "small": {
          "$value": "{size.2}"
        },
        "medium": {
          "$value": "{size.3}"
        },
        "large": {
          "$value": "{size.4}"
        }
      },
      "margin-inline": {
        "$type": "dimension",
        "$value": "{space.8}"
      },
      "color": {
        "$type": "color",
        "$description": "Color of the glyph beside a typed value: the value's role (decision leading-icon-color).",
        "default": {
          "$value": "{global.icon.on-base.neutral.primary}"
        },
        "disabled": {
          "$value": "{global.icon.state.disabled.default}"
        }
      },
      "placeholder-color": {
        "$type": "color",
        "$description": "Color of the glyph while the field is empty: the placeholder's role (decision leading-icon-color).",
        "default": {
          "$value": "{global.icon.on-base.neutral.tertiary}"
        },
        "disabled": {
          "$value": "{global.icon.state.disabled.default}"
        }
      }
    },
    "description": {
      "color": {
        "$type": "color",
        "default": {
          "$value": "{global.text.on-base.neutral.secondary}"
        },
        "disabled": {
          "$value": "{global.text.state.disabled.default}"
        }
      },
      "typography": {
        "$type": "typography",
        "$description": "Description text: the helper size, smaller than the label and the value (body.size.xs, xs, sm), regular weight, the normal line height and the normal letter spacing (Typography foundation).",
        "small": {
          "$value": {
            "fontFamily": "{body.family}",
            "fontSize": "{body.size.xs}",
            "fontWeight": "{body.weight.regular}",
            "lineHeight": "{font.line-height.normal}",
            "letterSpacing": "{font.letter-spacing.normal}"
          }
        },
        "medium": {
          "$value": {
            "fontFamily": "{body.family}",
            "fontSize": "{body.size.xs}",
            "fontWeight": "{body.weight.regular}",
            "lineHeight": "{font.line-height.normal}",
            "letterSpacing": "{font.letter-spacing.normal}"
          }
        },
        "large": {
          "$value": {
            "fontFamily": "{body.family}",
            "fontSize": "{body.size.sm}",
            "fontWeight": "{body.weight.regular}",
            "lineHeight": "{font.line-height.normal}",
            "letterSpacing": "{font.letter-spacing.normal}"
          }
        }
      }
    },
    "severity-icon": {
      "$description": "The severity icon, a glyph of the icon font, after the control or at the start of the message (severityIcon; Forms decisions forms-severity-icon-placement, -size, -color). Only the font, the sizes, the gaps and the color are tokenized.",
      "font-family": {
        "$type": "fontFamily",
        "$value": "{font.icon.family}"
      },
      "font-weight": {
        "$type": "fontWeight",
        "$value": "{font.icon.weight.light}"
      },
      "fill": {
        "$type": "number",
        "$value": "{font.icon.fill.off}"
      },
      "grade": {
        "$type": "number",
        "$value": "{font.icon.grade.normal}"
      },
      "optical-size": {
        "$type": "number",
        "$value": "{font.icon.optical-size.24}"
      },
      "size": {
        "$type": "dimension",
        "after-control": {
          "$description": "After the control: the size of the Button's icon at the same size (button.icon.size.small, medium, large: 20, 24, 24 px).",
          "small": {
            "$value": "{size.3}"
          },
          "medium": {
            "$value": "{size.4}"
          },
          "large": {
            "$value": "{size.4}"
          }
        },
        "message": {
          "$description": "At the start of the message: the Icon's size next to 14 and 16 px body text (16 px).",
          "$value": "{size.2}"
        }
      },
      "gap": {
        "$type": "dimension",
        "after-control": {
          "$description": "Between the control and the icon.",
          "$value": "{space.8}"
        },
        "message": {
          "$description": "Between the icon and the message text.",
          "$value": "{space.4}"
        }
      },
      "color": {
        "$type": "color",
        "$description": "The on-base icon role of the severity: the icon sits on the surface, beside the control or in the message, and takes the message text's color.",
        "error": {
          "$value": "{global.icon.on-base.functional.error.default}"
        },
        "warning": {
          "$value": "{global.icon.on-base.functional.warning.default}"
        },
        "success": {
          "$value": "{global.icon.on-base.functional.success.default}"
        }
      }
    },
    "message": {
      "color": {
        "$type": "color",
        "error": {
          "$value": "{global.text.on-base.functional.error.default}"
        },
        "warning": {
          "$value": "{global.text.on-base.functional.warning.default}"
        },
        "success": {
          "$value": "{global.text.on-base.functional.success.default}"
        }
      },
      "typography": {
        "$type": "typography",
        "$description": "Message text: the label's and the value's size (body.size.sm, md, md), larger than the description, so the message that says what to fix reads as easily as the field itself; medium weight, the normal line height and the normal letter spacing (Typography foundation).",
        "small": {
          "$value": {
            "fontFamily": "{body.family}",
            "fontSize": "{body.size.sm}",
            "fontWeight": "{body.weight.medium}",
            "lineHeight": "{font.line-height.normal}",
            "letterSpacing": "{font.letter-spacing.normal}"
          }
        },
        "medium": {
          "$value": {
            "fontFamily": "{body.family}",
            "fontSize": "{body.size.md}",
            "fontWeight": "{body.weight.medium}",
            "lineHeight": "{font.line-height.normal}",
            "letterSpacing": "{font.letter-spacing.normal}"
          }
        },
        "large": {
          "$value": {
            "fontFamily": "{body.family}",
            "fontSize": "{body.size.md}",
            "fontWeight": "{body.weight.medium}",
            "lineHeight": "{font.line-height.normal}",
            "letterSpacing": "{font.letter-spacing.normal}"
          }
        }
      }
    }
  }
}
