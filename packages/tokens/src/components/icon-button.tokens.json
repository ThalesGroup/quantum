{
  "$description": "Component tokens for Icon button. Path grammar: icon-button.<part>.<property>[.<emphasis>][.<intent>][.<state>] for colors (disabled depends on emphasis only), icon-button.<part>.<property>.<size> for dimensions. Parts, options and states must exist in packages/components/specs/components/icon-button.spec.json. Values alias semantic tokens only (Figma library mapped colors and scales, and the additions).",
  "icon-button": {
    "container": {
      "background": {
        "$type": "color",
        "accent": {
          "neutral": {
            "default": { "$value": "{global.bg.accent.neutral.default}" },
            "hover": { "$value": "{global.bg.accent.neutral.hover}" },
            "active": { "$value": "{global.bg.accent.neutral.active}" }
          },
          "brand": {
            "default": { "$value": "{global.bg.accent.brand.default}" },
            "hover": { "$value": "{global.bg.accent.brand.hover}" },
            "active": { "$value": "{global.bg.accent.brand.active}" }
          },
          "error": {
            "default": { "$value": "{global.bg.accent.functional.error.default}" },
            "hover": { "$value": "{global.bg.accent.functional.error.hover}" },
            "active": { "$value": "{global.bg.accent.functional.error.active}" }
          },
          "disabled": { "$value": "{global.bg.state.disabled.default}" }
        },
        "subtle": {
          "neutral": {
            "default": { "$value": "{global.bg.subtle.neutral.default}" },
            "hover": { "$value": "{global.bg.subtle.neutral.hover}" },
            "active": { "$value": "{global.bg.subtle.neutral.active}" }
          },
          "brand": {
            "default": { "$value": "{global.bg.subtle.brand.default}" },
            "hover": { "$value": "{global.bg.subtle.brand.hover}" },
            "active": { "$value": "{global.bg.subtle.brand.active}" }
          },
          "error": {
            "default": { "$value": "{global.bg.subtle.functional.error.default}" },
            "hover": { "$value": "{global.bg.subtle.functional.error.hover}" },
            "active": { "$value": "{global.bg.subtle.functional.error.active}" }
          },
          "disabled": { "$value": "{global.bg.state.disabled.default}" }
        },
        "ghost": {
          "neutral": {
            "default": { "$value": "{color.transparent}" },
            "hover": { "$value": "{global.bg.subtle.neutral.default}" },
            "active": { "$value": "{global.bg.subtle.neutral.hover}" }
          },
          "brand": {
            "default": { "$value": "{color.transparent}" },
            "hover": { "$value": "{global.bg.subtle.brand.default}" },
            "active": { "$value": "{global.bg.subtle.brand.hover}" }
          },
          "error": {
            "default": { "$value": "{color.transparent}" },
            "hover": { "$value": "{global.bg.subtle.functional.error.default}" },
            "active": { "$value": "{global.bg.subtle.functional.error.hover}" }
          },
          "disabled": { "$value": "{global.bg.state.disabled.default}" }
        }
      },
      "border-color": {
        "$type": "color",
        "accent": {
          "neutral": {
            "default": { "$value": "{global.border.accent.neutral.default}" },
            "hover": { "$value": "{global.border.accent.neutral.hover}" },
            "active": { "$value": "{global.border.accent.neutral.active}" }
          },
          "brand": {
            "default": { "$value": "{global.border.accent.brand.default}" },
            "hover": { "$value": "{global.border.accent.brand.hover}" },
            "active": { "$value": "{global.border.accent.brand.active}" }
          },
          "error": {
            "default": { "$value": "{global.border.accent.functional.error.default}" },
            "hover": { "$value": "{global.border.accent.functional.error.hover}" },
            "active": { "$value": "{global.border.accent.functional.error.active}" }
          },
          "disabled": { "$value": "{global.border.state.disabled.default}" }
        },
        "subtle": {
          "neutral": {
            "default": { "$value": "{global.border.subtle.neutral.default}" },
            "hover": { "$value": "{global.border.subtle.neutral.hover}" },
            "active": { "$value": "{global.border.subtle.neutral.active}" }
          },
          "brand": {
            "default": { "$value": "{global.border.subtle.brand.default}" },
            "hover": { "$value": "{global.border.subtle.brand.hover}" },
            "active": { "$value": "{global.border.subtle.brand.active}" }
          },
          "error": {
            "default": { "$value": "{global.border.subtle.functional.error.default}" },
            "hover": { "$value": "{global.border.subtle.functional.error.hover}" },
            "active": { "$value": "{global.border.subtle.functional.error.active}" }
          },
          "disabled": { "$value": "{global.border.state.disabled.default}" }
        },
        "ghost": {
          "neutral": {
            "default": { "$value": "{color.transparent}" },
            "hover": { "$value": "{global.border.subtle.neutral.default}" },
            "active": { "$value": "{global.border.subtle.neutral.hover}" }
          },
          "brand": {
            "default": { "$value": "{color.transparent}" },
            "hover": { "$value": "{global.border.subtle.brand.default}" },
            "active": { "$value": "{global.border.subtle.brand.hover}" }
          },
          "error": {
            "default": { "$value": "{color.transparent}" },
            "hover": { "$value": "{global.border.subtle.functional.error.default}" },
            "active": { "$value": "{global.border.subtle.functional.error.hover}" }
          },
          "disabled": { "$value": "{global.border.state.disabled.default}" }
        }
      },
      "border-width": { "$type": "dimension", "$value": "{stroke-width.sm}" },
      "border-radius": {
        "$type": "dimension",
        "xsmall": { "$value": "{corner-radius.2xs}" },
        "small": { "$value": "{corner-radius.2xs}" },
        "medium": { "$value": "{corner-radius.xs}" },
        "large": { "$value": "{corner-radius.xs}" }
      },
      "min-height": {
        "$type": "dimension",
        "xsmall": { "$value": "{space.24}" },
        "small": { "$value": "{space.28}" },
        "medium": { "$value": "{space.36}" },
        "large": { "$value": "{space.44}" }
      },
      "min-width": {
        "$type": "dimension",
        "$description": "Equal to min-height: the container is square at every size and on every platform overlay.",
        "xsmall": { "$value": "{space.24}" },
        "small": { "$value": "{space.28}" },
        "medium": { "$value": "{space.36}" },
        "large": { "$value": "{space.44}" }
      },
      "outline-width": {
        "$type": "dimension",
        "focus-visible": { "$value": "{focus.ring.width}" }
      },
      "outline-offset": {
        "$type": "dimension",
        "focus-visible": { "$value": "{focus.ring.offset}" }
      },
      "outline-color": {
        "$type": "color",
        "focus-visible": { "$value": "{color.focus.ring}" }
      },
      "transition": {
        "duration": { "$type": "duration", "$value": "{duration.fast}" },
        "easing": { "$type": "cubicBezier", "$value": "{easing.standard}" }
      }
    },
    "icon": {
      "color": {
        "$type": "color",
        "accent": {
          "neutral": {
            "default": { "$value": "{global.icon.on-accent.neutral.primary}" },
            "hover": { "$value": "{global.icon.on-accent.neutral.primary}" },
            "active": { "$value": "{global.icon.on-accent.neutral.primary}" }
          },
          "brand": {
            "default": { "$value": "{global.icon.on-accent.brand.default}" },
            "hover": { "$value": "{global.icon.on-accent.brand.default}" },
            "active": { "$value": "{global.icon.on-accent.brand.default}" }
          },
          "error": {
            "default": { "$value": "{global.icon.on-accent.functional.error.default}" },
            "hover": { "$value": "{global.icon.on-accent.functional.error.default}" },
            "active": { "$value": "{global.icon.on-accent.functional.error.default}" }
          },
          "disabled": { "$value": "{global.icon.state.disabled.default}" }
        },
        "subtle": {
          "neutral": {
            "default": { "$value": "{global.icon.on-base.neutral.primary}" },
            "hover": { "$value": "{global.icon.on-base.neutral.primary}" },
            "active": { "$value": "{global.icon.on-base.neutral.primary}" }
          },
          "brand": {
            "default": { "$value": "{global.icon.on-subtle.brand.default}" },
            "hover": { "$value": "{global.icon.on-subtle.brand.default}" },
            "active": { "$value": "{global.icon.on-subtle.brand.default}" }
          },
          "error": {
            "default": { "$value": "{global.icon.on-subtle.functional.error.default}" },
            "hover": { "$value": "{global.icon.on-subtle.functional.error.default}" },
            "active": { "$value": "{global.icon.on-subtle.functional.error.default}" }
          },
          "disabled": { "$value": "{global.icon.state.disabled.default}" }
        },
        "ghost": {
          "neutral": {
            "default": { "$value": "{global.icon.on-base.neutral.primary}" },
            "hover": { "$value": "{global.icon.on-base.neutral.primary}" },
            "active": { "$value": "{global.icon.on-base.neutral.primary}" }
          },
          "brand": {
            "default": { "$value": "{global.icon.on-base.brand.default}" },
            "hover": { "$value": "{global.icon.on-subtle.brand.default}" },
            "active": { "$value": "{global.icon.on-subtle.brand.default}" }
          },
          "error": {
            "default": { "$value": "{global.icon.on-subtle.functional.error.default}" },
            "hover": { "$value": "{global.icon.on-subtle.functional.error.default}" },
            "active": { "$value": "{global.icon.on-subtle.functional.error.default}" }
          },
          "disabled": { "$value": "{global.icon.state.disabled.default}" }
        }
      },
      "$description": "The glyph is the only visible content: it takes the color the button label takes in the same emphasis, intent and state, and the icon font of every component.",
      "font-family": { "$type": "fontFamily", "$value": "{font.icon.family}" },
      "font-weight": { "$type": "fontWeight", "$value": "{font.icon.weight.light}" },
      "fill": { "$type": "number", "$value": "{font.icon.fill.off}" },
      "grade": { "$type": "number", "$value": "{font.icon.grade.normal}" },
      "optical-size": { "$type": "number", "$value": "{font.icon.optical-size.20}" },
      "size": {
        "$type": "dimension",
        "xsmall": { "$value": "{size.2}" },
        "small": { "$value": "{size.3}" },
        "medium": { "$value": "{size.4}" },
        "large": { "$value": "{size.4}" }
      }
    }
  }
}
