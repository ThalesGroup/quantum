{
  "$description": "Component tokens for Dropdown. The trigger is a Button (its own tokens, button.*), so only the menu is tokenized here. Path grammar: dropdown.<part>.<property>[.<intent>][.<state>], where <intent> is the item's intent (neutral, error); disabled depends on nothing else. Parts, options and states must exist in packages/components/specs/components/dropdown.spec.json. Values alias semantic tokens only (Figma library mapped colors and scales, and the additions).",
  "dropdown": {
    "menu": {
      "background": { "$type": "color", "$value": "{global.bg.level.2.default}", "$description": "The menu is a level 2 surface, whatever the surface it opens over: in dark mode it stays lighter than the page and than a level 1 panel." },
      "border-color": { "$type": "color", "$value": "{global.border.level.edge.level.2}" },
      "border-width": { "$type": "dimension", "$value": "{stroke-width.sm}" },
      "border-radius": { "$type": "dimension", "$value": "{corner-radius.sm}" },
      "padding": { "$type": "dimension", "$value": "{space.8}", "$description": "Wider than the focus ring and its offset, so the ring of an item is never cut by the menu edge." },
      "offset": { "$type": "dimension", "$value": "{space.4}", "$description": "Distance between the trigger and the menu." }
    },
    "separator": {
      "color": { "$type": "color", "$value": "{global.border.level.on-level.2}" },
      "width": { "$type": "dimension", "$value": "{stroke-width.sm}" },
      "margin-block": { "$type": "dimension", "$value": "{space.4}" }
    },
    "item": {
      "background": {
        "$type": "color",
        "$description": "The ghost button's tint: no fill at rest, the subtle fill of the intent on hover, the next step on press.",
        "neutral": {
          "default": { "$value": "{color.transparent}" },
          "hover": { "$value": "{global.bg.subtle.neutral.default}" },
          "active": { "$value": "{global.bg.subtle.neutral.hover}" }
        },
        "error": {
          "default": { "$value": "{color.transparent}" },
          "hover": { "$value": "{global.bg.subtle.functional.error.default}" },
          "active": { "$value": "{global.bg.subtle.functional.error.hover}" }
        },
        "disabled": { "$value": "{color.transparent}" }
      },
      "min-height": { "$type": "dimension", "$value": "{space.32}" },
      "padding-inline": { "$type": "dimension", "$value": "{space.8}" },
      "gap": { "$type": "dimension", "$value": "{space.8}" },
      "border-radius": { "$type": "dimension", "$value": "{corner-radius.2xs}" },
      "outline-width": {
        "$type": "dimension",
        "focus-visible": { "$value": "{focus.ring.width}" }
      },
      "outline-offset": {
        "$type": "dimension",
        "focus-visible": { "$value": "{focus.ring.offset}" }
      },
      "outline-color": {
        "$type": "color",
        "focus-visible": { "$value": "{color.focus.ring}" }
      },
      "transition": {
        "duration": { "$type": "duration", "$value": "{duration.fast}" },
        "easing": { "$type": "cubicBezier", "$value": "{easing.standard}" }
      }
    },
    "item-label": {
      "color": {
        "$type": "color",
        "neutral": {
          "default": { "$value": "{global.text.on-subtle.neutral.default}" },
          "hover": { "$value": "{global.text.on-subtle.neutral.default}" },
          "active": { "$value": "{global.text.on-subtle.neutral.default}" }
        },
        "error": {
          "default": { "$value": "{global.text.on-subtle.functional.error.default}" },
          "hover": { "$value": "{global.text.on-subtle.functional.error.default}" },
          "active": { "$value": "{global.text.on-subtle.functional.error.default}" }
        },
        "disabled": { "$value": "{global.text.state.disabled.default}" }
      },
      "typography": { "$type": "typography", "$value": {"fontFamily": "{body.family}", "fontSize": "{body.size.sm}", "fontWeight": "{body.weight.medium}", "lineHeight": "{font.line-height.tight}", "letterSpacing": "{font.letter-spacing.normal}"} }
    },
    "item-icon": {
      "$description": "Glyphs of the icon font. They inherit the item label color through currentColor, so only the font and its size are tokenized.",
      "font-family": { "$type": "fontFamily", "$value": "{font.icon.family}" },
      "font-weight": { "$type": "fontWeight", "$value": "{font.icon.weight.light}" },
      "fill": { "$type": "number", "$value": "{font.icon.fill.off}" },
      "grade": { "$type": "number", "$value": "{font.icon.grade.normal}" },
      "optical-size": { "$type": "number", "$value": "{font.icon.optical-size.20}" },
      "size": { "$type": "dimension", "$value": "{size.2}" }
    }
  }
}
