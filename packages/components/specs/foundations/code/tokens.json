{
  "$description": "Code colors, light mode (the Figma library's Colors / Mapped).",
  "global": {
    "text": {
      "code": {
        "$type": "color",
        "keyword": { "$value": "{extended.lavender.700}" },
        "string": {
          "$value": {
            "colorSpace": "srgb",
            "components": [0.0943, 0.3804, 0.3059],
            "alpha": 1,
            "hex": "#18614e"
          },
          "$extensions": {
            "io.quantum": { "deprecated": false, "since": "0.1.0", "aliases": null }
          }
        }
      }
    }
  },
  "size": {
    "$type": "dimension",
    "control": { "md": { "$value": { "value": 40, "unit": "px" } } }
  }
}
